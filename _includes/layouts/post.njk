---
layout: layouts/base.njk
templateClass: tmpl-post
---
<h1>{{ title }}</h1>

<time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
{%- for tag in tags | filterTagList -%}
  {%- set tagUrl %}/tags/{{ tag | slug }}/{% endset -%}
  <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
{%- endfor %}

{{ content | safe }}

{# Prefer the built-in tag collection 'post' #}
{%- set coll = collections['post'] or collections.posts -%}
{%- if coll and (coll | length) > 0 -%}
  {%- set nextPost = coll | getNextCollectionItem(page) -%}
  {%- set previousPost = coll | getPreviousCollectionItem(page) -%}
  {%- if nextPost or previousPost -%}
    <hr>
    <ul>
      {%- if nextPost %}<li>Next: <a href="{{ nextPost.url | url }}">{{ nextPost.data.title }}</a></li>{% endif %}
      {%- if previousPost %}<li>Previous: <a href="{{ previousPost.url | url }}">{{ previousPost.data.title }}</a></li>{% endif %}
    </ul>
  {%- endif -%}
{%- endif -%}

<hr>
<p style="font-size:.85em;opacity:.6">
  DEBUG — coll['post']={{ (collections['post'] or []) | length }},
  coll.posts={{ (collections.posts or []) | length }},
  page.url={{ page.url }},
  tags=[{{ (tags or []) | join(', ') }}]
</p>
