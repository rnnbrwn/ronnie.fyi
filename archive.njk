---
layout: layouts/home.njk
permalink: /posts/
eleventyNavigation:
  key: Archive
  order: 3
---

<h1>Archive</h1>

{% set sortedPosts = collections.sortedPosts %}
{% if not sortedPosts or (sortedPosts | length) == 0 %}
  <p>No posts yet.</p>
{% else %}
  {% set monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"] %}
  {% set currentYear = -1 %}
  {% set currentMonth = -1 %}

  {% for item in sortedPosts %}
    {% set postDate = item.data.date %}
    {% if postDate %}
      {% set year = postDate.getFullYear() %}
      {% set month = postDate.getMonth() %}

      {% if year != currentYear %}
        {% if currentMonth != -1 %}</ul>{% endif %}
        <h2 class="archive-year">{{ year }}</h2>
        {% set currentYear = year %}
        {% set currentMonth = -1 %}
      {% endif %}

      {% if month != currentMonth %}
        {% if currentMonth != -1 %}</ul>{% endif %}
        <h3 class="archive-month">{{ monthNames[month] }}</h3>
        {% set currentMonth = month %}
        <ul class="archive-posts">
      {% endif %}

      <li class="archive-post-item">
        <a href="{{ item.url | url }}" class="archive-post-link">{{ item.data.title }}</a>
        <time class="archive-post-date" datetime="{{ postDate | htmlDateString }}">{{ postDate | readableDate }}</time>
      </li>
    {% endif %}
  {% endfor %}
  {% if currentMonth != -1 %}</ul>{% endif %}
{% endif %}
