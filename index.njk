---
layout: layouts/home.njk
eleventyNavigation:
  key: Home
  order: 1
---
{# Combine markdown posts with Contentful posts #}
{% set markdownPosts = collections.post %}
{% set contentfulPostsData = contentfulPosts or [] %}
{% set allPosts = [] %}

{# Add markdown posts to allPosts array #}
{% for post in markdownPosts %}
  {% set allPosts = (allPosts.push(post), allPosts) %}
{% endfor %}

{# Add Contentful posts to allPosts array #}
{% for post in contentfulPostsData %}
  {% set contentfulPost = {
    url: "/contentful-posts/" + post.slug + "/",
    data: {
      title: post.title,
      date: post.date
    },
    date: post.date,
    title: post.title
  } %}
  {% set allPosts = (allPosts.push(contentfulPost), allPosts) %}
{% endfor %}

{# Sort all posts by date (newest first) #}
{% set sortedPosts = allPosts | sort(false, false, 'date') %}

{% set maxPosts = (sortedPosts | length) | min(6) %}
<h1>Latest {% if maxPosts == 1 %}Post{% else %}{{ maxPosts }} Posts{% endif %}</h1>

{% set postslist = sortedPosts | head(6) %}
{% set postslistCounter = sortedPosts | length %}
{% include "postslist.njk" %}

<p>More posts can be found in <a href="{{ '/posts/' | url }}">the archive</a>.</p>

{% if currentTrack.current and currentTrack.current.song and currentTrack.current.artist %}
<p class="current-listening">
  I'm currently listening to 
  {% if currentTrack.current.url and not currentTrack.error %}
    <a href="{{ currentTrack.current.url }}" target="_blank" rel="noopener noreferrer">{{ currentTrack.current.song }}</a>
  {% else %}
    {{ currentTrack.current.song }}
  {% endif %}
  by <strong>{{ currentTrack.current.artist }}</strong>{% if currentTrack.current.playedAt %} <small>(<span class="relative-time" data-played-at="{{ currentTrack.current.playedAt }}">{{ currentTrack.current.playedAt | relativeTime }}</span>)</small>{% endif %}.
</p>

{% if currentTrack.recent and currentTrack.recent.length > 0 %}
<details class="recently-played">
  <summary>Recently played tracks</summary>
  <ul class="track-list">
    {% for track in currentTrack.recent %}
    <li class="track-item">
      <a href="{{ track.url }}" target="_blank" rel="noopener noreferrer">{{ track.song }}</a>
      by {{ track.artist }}
    </li>
    {% endfor %}
  </ul>
</details>
{% endif %}
{% endif %}
