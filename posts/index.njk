---
layout: layouts/base.njk
title: Blog
permalink: /posts/
---

<h1>Blog</h1>

<ul>
{%- for post in collections.posts | reverse -%}
  <li>
    <a href="{{ post.url | url }}">{{ post.data.title }}</a>
    <small> — <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></small>
  </li>
{%- endfor -%}
</ul>
