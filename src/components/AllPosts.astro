---
import Post from './Post.astro';
import { getSortedPosts, getPostUrl } from '../utils/getSortedPosts';

// Shift all heading levels in an HTML string up by one (capped at h6).
// Used so that in-post headings (written as h2+ for the single post page where
// the title is h1) remain structurally subordinate to the h2 post card title
// on listing pages.
function shiftHeadings(html: string): string {
	return html.replace(/<(\/?)h([1-6])(\b)/g, (_, slash, level) => {
		const newLevel = Math.min(6, parseInt(level) + 1);
		return `<${slash}h${newLevel}`;
	});
}

interface Props {
	limit?: number;
	pinFirst?: boolean;
}

const { limit, pinFirst = false } = Astro.props;

let allPosts = await getSortedPosts();

if (pinFirst) {
	const pinned = allPosts.filter((p) => p.collection === 'blog' && p.entry.data.pinned);
	const rest = allPosts.filter((p) => !(p.collection === 'blog' && p.entry.data.pinned));
	allPosts = [...pinned, ...rest];
}

const posts = limit ? allPosts.slice(0, limit) : allPosts;
---

{
	posts.map((post) => {
		const isDigest = post.collection === 'notes';
		const entry = post.entry;
		const tags = post.collection === 'blog' ? entry.data.tags : [];
		const image = post.collection === 'blog' ? entry.data.image : undefined;
		const pinned = post.collection === 'blog' ? entry.data.pinned : false;
		const href = isDigest ? `/notes/${entry.id}` : getPostUrl(entry.data.pubDate, entry.id);
		const html = shiftHeadings(entry.rendered?.html ?? '');

		return (
			<Post
				id={entry.id}
				title={entry.data.title}
				pubDate={entry.data.pubDate}
				tags={tags}
				image={image}
				pinned={pinned}
				isDigest={isDigest}
				href={href}
				html={html}
			/>
		);
	})
}
