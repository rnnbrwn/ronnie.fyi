---
import Post from './Post.astro';
import { getSortedPosts, getPostUrl, isEffectivelyPinned, isDraft } from '../utils/getSortedPosts';
import type { BlogPost, ShelfEventPost } from '../utils/getSortedPosts';
import type { BskyActor } from '../utils/bsky';
import { fetchBskyInteractors } from '../utils/bsky';

// Shift all heading levels in an HTML string up by one (capped at h6).
// Used so that in-post headings (written as h2+ for the single post page where
// the title is h1) remain structurally subordinate to the h2 post card title
// on listing pages.
function shiftHeadings(html: string): string {
	return html.replace(/<(\/?)h([1-6])(\b)/g, (_, slash, level) => {
		const newLevel = Math.min(6, parseInt(level) + 1);
		return `<${slash}h${newLevel}`;
	});
}

interface Props {
	limit?: number;
	offset?: number;
	pinFirst?: boolean;
	relativeDate?: boolean;
}

const { limit, offset = 0, pinFirst = false, relativeDate = false } = Astro.props;

let allPosts = await getSortedPosts();

if (pinFirst) {
	const pinned = allPosts.filter((p) => p.collection === 'blog' && isEffectivelyPinned(p.entry.data));
	const rest = allPosts.filter((p) => !(p.collection === 'blog' && isEffectivelyPinned(p.entry.data)));
	allPosts = [...pinned, ...rest];
}

const posts = limit ? allPosts.slice(offset, offset + limit) : allPosts.slice(offset);

const bskyInteractorsMap = new Map<string, BskyActor[]>();
await Promise.all(
	posts
		.filter((p) => p.collection === 'blog' && p.entry.data.bskyPostUri)
		.map(async (p) => {
			const uri = (p as BlogPost).entry.data.bskyPostUri as string;
			const interactors = await fetchBskyInteractors(uri);
			if (interactors.length > 0) bskyInteractorsMap.set(p.entry.id, interactors);
		})
);
---

{
	posts.map((post) => {
		const isDigest = post.collection === 'notes';
		const isShelfEvent = post.collection === 'shelf-events';
		const entry = post.entry;
		const tags = post.collection === 'blog' ? (post as BlogPost).entry.data.tags : [];
		const image = post.collection === 'blog' ? (post as BlogPost).entry.data.image : undefined;
		const pinned = post.collection === 'blog' ? isEffectivelyPinned((post as BlogPost).entry.data) : false;
		const draft = isDraft(entry.id);
		const href = isDigest
			? `/notes/${entry.id}`
			: isShelfEvent
			? '/shelf'
			: getPostUrl(entry.data.pubDate, entry.id);
		const html = shiftHeadings(entry.rendered?.html ?? '');
		const rating = isShelfEvent ? (post as ShelfEventPost).entry.data.rating : undefined;

		return (
			<Post
				id={entry.id}
				title={entry.data.title}
				pubDate={entry.data.pubDate}
				tags={tags}
				image={image}
				pinned={pinned}
				draft={draft}
				isDigest={isDigest}
				isShelfEvent={isShelfEvent}
				rating={rating}
				href={href}
				html={html}
				relativeDate={relativeDate}
				bskyPostUri={post.collection === 'blog' ? (post as BlogPost).entry.data.bskyPostUri : undefined}
				bskyInteractors={bskyInteractorsMap.get(entry.id)}
			/>
		);
	})
}
