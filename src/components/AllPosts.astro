---
import { render } from 'astro:content';
import Post from './Post.astro';
import { getSortedPosts } from '../utils/getSortedPosts';

interface Props {
	limit?: number;
	pinFirst?: boolean;
}

const { limit, pinFirst = false } = Astro.props;

let allPosts = await getSortedPosts();

if (pinFirst) {
	allPosts = [
		...allPosts.filter((p) => p.data.pinned),
		...allPosts.filter((p) => !p.data.pinned),
	];
}

const posts = limit ? allPosts.slice(0, limit) : allPosts;

const renderedPosts = await Promise.all(
	posts.map(async (post) => ({
		post,
		Content: (await render(post)).Content,
	})),
);
---

{
	renderedPosts.map(({ post, Content }) => (
		<Post id={post.id} title={post.data.title} pubDate={post.data.pubDate} tags={post.data.tags} image={post.data.image} pinned={post.data.pinned}>
			<Content />
		</Post>
	))
}
