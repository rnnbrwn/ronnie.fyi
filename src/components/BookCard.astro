---
import type { UserBook } from '../utils/hardcover';

interface Props {
	ub: UserBook;
	postUrl?: string;
}

const { ub, postUrl } = Astro.props;
const authorsList = ub.book.contributions.map((c) => c.author.name);
const MAX_AUTHORS = 3;
const visibleAuthors = authorsList.slice(0, MAX_AUTHORS);
const hasMoreAuthors = authorsList.length > MAX_AUTHORS;
const hardcoverUrl = `https://hardcover.app/books/${ub.book.slug}`;

function normalize(str: string) {
	return str.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]/g, '');
}

const bookTitleNorm = normalize(ub.book.title);
const series = ub.book.book_series.find(({ position, series: s }) => {
	const seriesNorm = normalize(s.name);
	if (seriesNorm.length === 0) return false;
	// Filter out positionless entries where the series name is just the book title repeated
	if (position === null && bookTitleNorm.includes(seriesNorm)) return false;
	return true;
});
---

<li id={`book-${ub.book.id}`} class='book-card' data-series={series?.series.name} data-authors={authorsList.join('|')}>
	<a class='book-cover-link' href={hardcoverUrl} target='_blank' rel='noopener noreferrer'>
		{ub.book.image
			? <img src={ub.book.image.url} alt={ub.book.title} loading='lazy' />
			: <div class='no-cover' aria-hidden='true'>
					<span class='no-cover-title'>{ub.book.title}</span>
					{visibleAuthors[0] && <span class='no-cover-author'>{visibleAuthors[0]}</span>}
				</div>
		}
	</a>
	<p class='book-title'>{ub.book.title}</p>
	<p class='book-author'>
		{visibleAuthors.map((name, i) => (
			<>{i > 0 && ', '}<button class='book-author-btn' data-author-name={name}>{name}</button></>
		))}
		{hasMoreAuthors && <span> et al.</span>}
	</p>
	{series && (
		<button class='book-series' data-series-name={series.series.name}>
			{series.series.name}
			{series.position != null && ` · #${series.position}`}
		</button>
	)}
	{ub.rating === 5 && <span class='book-recommended'>Loved it</span>}
	{postUrl && <a href={postUrl} class='book-post-link' aria-label={`Blog post about ${ub.book.title}`}>Blog Post →</a>}
</li>

<style lang='scss'>
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';
	@use 'sass:map';

	.book-card {		display: flex;
		flex-direction: column;
	}

	.book-cover-link {
		display: block;

		&:hover img,
		&:hover .no-cover {
			opacity: 0.85;
		}

		&:focus-visible {
			@include layout.focus-ring(colors.$primary);
		}
	}

	img {
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		display: block;
		border-radius: layout.$radius-xs;
	}

	.no-cover {
		width: 100%;
		aspect-ratio: 2 / 3;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: spacing.$space-2;
		padding: spacing.$space-3;
		border-radius: layout.$radius-xs;
		background-color: map.get(colors.$dark-tones, 'tone-3');
		box-sizing: border-box;

		:global(html[data-theme='dark']) & {
			background-color: map.get(colors.$light-tones, 'tone-2');
		}
	}

	.no-cover-title {		font-size: typography.$font-size-sm;
		font-weight: typography.$weight-bold;
		color: colors.$light;
		line-height: typography.$leading-snug;
		@include typography.line-clamp(4);

		:global(html[data-theme='dark']) & {
			color: colors.$dark;
		}
	}

	.no-cover-author {		font-size: typography.$font-size-sm;
		font-weight: typography.$weight-regular;
		color: map.get(colors.$light-tones, 'tone-2');
		line-height: typography.$leading-snug;
		@include typography.line-clamp(2);

		:global(html[data-theme='dark']) & {
			color: colors.$text-muted;
		}
	}

	.book-title {		font-size: typography.$font-size-md;
		font-weight: typography.$weight-semibold;
		margin-top: spacing.$space-2;
		margin-bottom: spacing.$space-1;
		line-height: typography.$leading-snug;
		@include typography.line-clamp(3);
	}

	.book-author {		font-size: typography.$font-size-md;
		color: colors.$text-muted;
		margin: 0;
		line-height: typography.$leading-snug;

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');
		}
	}

	.book-author-btn {
		@include layout.button-reset;		font-size: typography.$font-size-md;
		color: inherit;
		@include layout.dotted-link;

		&:hover {
			color: colors.$primary;
		}

		&:focus-visible {
			@include layout.focus-ring(colors.$primary);
		}
	}

	.book-series {
		@include layout.button-reset;		font-size: typography.$font-size-md;
		font-style: italic;
		font-weight: typography.$weight-semibold;
		color: colors.$text-muted;
		margin: 0;
		line-height: typography.$leading-snug;
		text-align: left;
		@include layout.dotted-link;

		&:hover {
			color: colors.$primary;
		}

		&:focus-visible {
			@include layout.focus-ring(colors.$primary);
		}

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');

			&:hover {
				color: colors.$primary;
			}
		}
	}

	.book-recommended {
		display: inline-block;
		align-self: flex-start;		font-size: typography.$font-size-sm;
		font-weight: typography.$weight-semibold;
		letter-spacing: typography.$tracking-wider;
		text-transform: uppercase;
		color: colors.$light;
		background-color: colors.$primary;
		padding: 1px spacing.$space-2;
		border-radius: layout.$radius-xs;
		margin-top: spacing.$space-2;
		margin-bottom: 0;

	}

	.book-post-link {
		display: inline-block;		font-size: typography.$font-size-md;
		color: colors.$text-muted;
		@include layout.dotted-link;
		margin-top: spacing.$space-1;

		&:hover {
			color: colors.$primary;
		}

		&:focus-visible {
			@include layout.focus-ring(colors.$primary);
		}

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');
		}
	}
</style>
