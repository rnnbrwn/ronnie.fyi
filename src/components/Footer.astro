---
const currentYear = new Date().getFullYear();
---

<footer>
	<p><a href='/'>ronnie.fyi</a> | Online from 2001 - {currentYear} in some guise or other.</p>
</footer>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/breakpoints';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/typography';

	footer {
		margin-top: auto;
		padding: spacing.$space-6 spacing.$space-4;

		@media (min-width: breakpoints.$md) {
			padding: spacing.$space-6 spacing.$space-24;
		}

		p {
			font-family: typography.$font-body;
			color: colors.$dark;
			text-decoration: none;
			font-weight: typography.$weight-regular;
			font-size: typography.$font-size-md;
			a {
				@include layout.body-link;
			}

			:global(html[data-theme='dark']) & {
				color: map.get(colors.$light-tones, 'tone-2');
				a {
					@include layout.body-link-on-dark;
				}
			}
		}
	}
</style>
