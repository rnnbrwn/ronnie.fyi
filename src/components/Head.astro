---
interface Props {
	title?: string;
	description?: string;
}

const { title = 'ronnie.fyi', description } = Astro.props;
---

<meta name='viewport' content='width=device-width, initial-scale=1' />
<link rel='preload' href='/fonts/Geomanist-Bold.otf' as='font' type='font/otf' crossorigin />
<link rel='preconnect' href='https://fonts.googleapis.com' />
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
<link
	href='https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap'
	rel='stylesheet'
/>
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='canonical' href={new URL(Astro.url.pathname, Astro.site).href} />
<meta name='generator' content={Astro.generator} />
{description && <meta name='description' content={description} />}
<meta property='og:title' content={title} />
{description && <meta property='og:description' content={description} />}
<meta property='og:url' content={new URL(Astro.url.pathname, Astro.site).href} />
<meta property='og:type' content='website' />
<title>{title}</title>
