---
interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const { title = 'ronnie.fyi', description, ogImage } = Astro.props;
---

<meta name='viewport' content='width=device-width, initial-scale=1' />
<link rel='preconnect' href='https://fonts.googleapis.com' />
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
<link
	href='https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap'
	rel='stylesheet'
/>
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='alternate' type='application/rss+xml' title='ronnie.fyi' href='/rss' />
<link rel='canonical' href={new URL(Astro.url.pathname, Astro.site).href} />
<meta name='generator' content={Astro.generator} />
{description && <meta name='description' content={description} />}
<meta property='og:title' content={title} />
{description && <meta property='og:description' content={description} />}
<meta property='og:url' content={new URL(Astro.url.pathname, Astro.site).href} />
<meta property='og:type' content='website' />
{ogImage && <meta property='og:image' content={ogImage} />}
{ogImage && <meta name='twitter:card' content='summary_large_image' />}
{ogImage && <meta name='twitter:image' content={ogImage} />}
<title>{title}</title>
