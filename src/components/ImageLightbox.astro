---
// Mounted once, globally, in Base.astro. Its script listens for clicks on any
// .image-group-trigger button anywhere on the page (there can be several, one per
// grouped set of images — see src/utils/imageGroups.ts) and opens this single
// modal, navigating within whichever group was clicked.
import IconClose from './IconClose.astro';
import IconChevronLeft from './IconChevronLeft.astro';
import IconChevronRight from './IconChevronRight.astro';
---

<dialog id='image-lightbox' aria-label='Image viewer'>
	<button type='button' class='lightbox-close' aria-label='Close'>
		<IconClose size={28} />
	</button>
	<button type='button' class='lightbox-prev' aria-label='Previous image'>
		<IconChevronLeft size={32} />
	</button>
	<img class='lightbox-image' alt='' />
	<button type='button' class='lightbox-next' aria-label='Next image'>
		<IconChevronRight size={32} />
	</button>
	<p class='lightbox-caption'></p>
</dialog>

<style lang='scss'>
	@use '../styles/abstracts/breakpoints';
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	dialog#image-lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		margin: 0;
		padding: spacing.$space-6;
		border: none;
		background: transparent;
		align-items: center;
		justify-content: center;

		&[open] {
			display: flex;
		}

		&::backdrop {
			background: colors.$dark;
			opacity: 0.92;
		}
	}

	.lightbox-image {
		display: block;
		max-width: 100%;
		max-height: calc(100vh - spacing.$space-24);
		object-fit: contain;
	}

	.lightbox-caption {
		position: absolute;
		bottom: spacing.$space-4;
		left: spacing.$space-4;
		right: spacing.$space-4;
		margin: 0;
		text-align: center;
		color: colors.$light;
		@include typography.caption-text;

		&:empty {
			display: none;
		}
	}

	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		@include layout.button-reset;
		position: absolute;
		display: grid;
		place-items: center;
		color: colors.$light;
		background-color: rgba(0, 0, 0, 0.45);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
		border-radius: 50%;
		width: spacing.$space-12;
		height: spacing.$space-12;

		&:hover {
			background-color: rgba(0, 0, 0, 0.65);
		}

		&:focus-visible {
			@include layout.focus-ring(colors.$light);
		}

		&[hidden] {
			display: none;
		}
	}

	.lightbox-close {
		top: spacing.$space-4;
		right: spacing.$space-4;
	}

	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-prev {
		left: spacing.$space-2;
	}

	.lightbox-next {
		right: spacing.$space-2;
	}

	@media (min-width: breakpoints.$md) {
		.lightbox-prev {
			left: spacing.$space-6;
		}

		.lightbox-next {
			right: spacing.$space-6;
		}
	}
</style>

<script>
	interface LightboxItem {
		full: string;
		alt: string;
		caption: string;
	}

	function initImageLightbox() {
		const el = document.getElementById('image-lightbox');
		if (!(el instanceof HTMLDialogElement)) return;
		const dialog: HTMLDialogElement = el; // an explicitly-typed const, so it stays non-null in every closure below

		const imageEl = dialog.querySelector<HTMLImageElement>('.lightbox-image')!;
		const captionEl = dialog.querySelector<HTMLElement>('.lightbox-caption')!;
		const closeBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-close')!;
		const prevBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-prev')!;
		const nextBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-next')!;

		let items: LightboxItem[] = [];
		let index = 0;
		let trigger: HTMLElement | null = null; // the button that opened the dialog, so focus can return to it
		let scrollY = 0; // page scroll position to restore once the dialog closes

		// <dialog>'s own modal behaviour doesn't reliably stop the page behind it from
		// scrolling on a touch device, so lock it by hand: pin the body in place at its
		// current scroll position, then undo that and jump back to it on close.
		function lockPageScroll() {
			scrollY = window.scrollY;
			document.body.style.position = 'fixed';
			document.body.style.top = `-${scrollY}px`;
			document.body.style.left = '0';
			document.body.style.right = '0';
		}

		function unlockPageScroll() {
			document.body.style.position = '';
			document.body.style.top = '';
			document.body.style.left = '';
			document.body.style.right = '';
			// Deferred a frame: restoring the scroll position in the same tick as
			// removing `position: fixed` can run before the browser reflows the page
			// back to its normal height, so the restore gets clamped short.
			requestAnimationFrame(() => window.scrollTo(0, scrollY));
		}

		function show(newIndex: number) {
			index = (newIndex + items.length) % items.length; // wrap around at either end
			const item = items[index];
			imageEl.src = item.full;
			imageEl.alt = item.alt;
			captionEl.textContent = item.caption;

			const multiple = items.length > 1;
			prevBtn.hidden = !multiple;
			nextBtn.hidden = !multiple;
		}

		function open(clicked: HTMLElement) {
			const group = clicked.closest('[data-image-group]');
			if (!group) return;

			const triggers = Array.from(group.querySelectorAll<HTMLElement>('.image-group-trigger'));
			items = triggers.map((t) => ({
				full: t.dataset.full ?? '',
				alt: t.querySelector('img')?.alt ?? '',
				caption: t.dataset.caption ?? '',
			}));

			trigger = clicked;
			show(triggers.indexOf(clicked));
			lockPageScroll();
			dialog.showModal();
		}

		document.addEventListener('click', (event) => {
			const clicked = (event.target as HTMLElement).closest<HTMLElement>('.image-group-trigger');
			if (clicked) open(clicked);
		});

		closeBtn.addEventListener('click', () => dialog.close());
		prevBtn.addEventListener('click', () => show(index - 1));
		nextBtn.addEventListener('click', () => show(index + 1));

		// A click that lands on the dialog's own box (not one of the elements above)
		// is a click on the backdrop area — close, same as clicking the X.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(index - 1);
			if (event.key === 'ArrowRight') show(index + 1);
			// Escape closes natively — <dialog> handles that without any code here.
		});

		// Fires however the dialog closed (X, backdrop click, or the native Escape
		// handling above), so focus reliably returns and the page scroll unlocks
		// no matter which way the dialog was dismissed.
		dialog.addEventListener('close', () => {
			unlockPageScroll();
			trigger?.focus({ preventScroll: true }); // .focus() otherwise scrolls the page to bring the trigger into view, fighting the scroll position we're restoring above
		});

		// Swipe left/right anywhere on the dialog (the image, the caption, the
		// backdrop) to move to the next/previous image — the touch equivalent of the
		// arrow buttons and arrow keys. A mostly-vertical drag is ignored, so it
		// doesn't fire on an accidental diagonal touch.
		let touchStartX = 0;
		let touchStartY = 0;
		const SWIPE_THRESHOLD = 40; // px

		dialog.addEventListener(
			'touchstart',
			(event) => {
				touchStartX = event.touches[0].clientX;
				touchStartY = event.touches[0].clientY;
			},
			{ passive: true }
		);

		dialog.addEventListener(
			'touchend',
			(event) => {
				const dx = event.changedTouches[0].clientX - touchStartX;
				const dy = event.changedTouches[0].clientY - touchStartY;
				if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy)) return;
				show(index + (dx < 0 ? 1 : -1));
			},
			{ passive: true }
		);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initImageLightbox);
	} else {
		initImageLightbox();
	}
</script>
