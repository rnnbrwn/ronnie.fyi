---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Posts' },
	// { href: '/about', label: 'About' },
	// { href: '/uses', label: 'Uses' },
];
---

<nav aria-label='Primary Navigation'>
	<ul>
		{
			links.map(({ href, label }) => (
				<li>
					<a href={href} aria-current={pathname === href || pathname === `${href}/` ? 'page' : undefined}>
						{label}
					</a>
				</li>
			))
		}
	</ul>
	<div class='nav-logo'><Logo aria-hidden='true' /></div>
</nav>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	nav {
		background-color: colors.$graphite;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: spacing.$space-4 spacing.$space-6;
		ul {
			padding: 0;
			margin: 0;
			display: flex;
			gap: spacing.$space-6;
			li {
				list-style: none;
			}
		}

		li a {
			font-family: typography.$font-body;
			color: colors.$ivory;
			text-decoration: none;
			font-weight: typography.$weight-extrabold;
			font-size: typography.$font-size-xl;
			line-height: typography.$leading-tight;
			text-transform: uppercase;
			&[aria-current='page'] {
				color: colors.$amber;
			}
			&:hover {
				color: colors.$amber;
			}
			&:focus-visible {
				color: colors.$amber;
				outline: 2px solid colors.$amber;
				outline-offset: 2px;
			}
		}
	}

	.nav-logo {
		display: none;
	}

	@media (min-width: 768px) {
		nav {
			width: layout.$nav-sidebar-width;
			flex-shrink: 0;
			position: sticky;
			top: 0;
			height: 100vh;
			overflow-y: auto;
			flex-direction: column;
			align-items: stretch;
			padding: spacing.$space-8;
			ul {
				flex-direction: column;
				gap: 0;
			}
			li a {
				font-size: typography.$font-size-5xl;
			}
		}

		.nav-logo {
			display: block;
			margin-top: auto;
			color: map.get(colors.$ivory-tones, 'tone-3');
		}
	}
</style>
