---
import SpotifyNowPlaying from './SpotifyNowPlaying.astro';
import IconBlueSky from './IconBlueSky.astro';
import IconGitHub from './IconGitHub.astro';
import IconRSS from './IconRSS.astro';

const pathname = Astro.url.pathname;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Posts' },
	{ href: '/about', label: 'About' },
	// { href: '/uses', label: '/Uses' },
];
---

<nav aria-label='Primary Navigation'>
	<ul>
		{
			links.map(({ href, label }) => (
				<li>
					<a
						href={href}
						aria-current={
							pathname === href ||
							pathname === `${href}/` ||
							(href === '/blog' && pathname.startsWith('/posts/'))
								? 'page'
								: undefined
						}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
	<div class='nav-bottom'>
		<SpotifyNowPlaying />
		<div class='social-links'>
			<a href='https://bsky.app/profile/ronnie.fyi' class='social-link' aria-label='Ronnie on Bluesky'>
				<IconBlueSky size={32} />
			</a>
			<a href='https://github.com/rnnbrwn/' class='social-link' aria-label='Ronnie on GitHub'>
				<IconGitHub size={32} />
			</a>
			<a href='/rss' class='social-link' aria-label='RSS feed'>
				<IconRSS size={38} />
			</a>
		</div>
	</div>
</nav>

<style lang='scss'>
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	nav {
		background-color: colors.$graphite;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: spacing.$space-4 spacing.$space-6;

		ul {
			padding: 0;
			margin: 0;
			display: flex;
			gap: spacing.$space-6;
			li {
				list-style: none;
			}
		}

		li a {
			font-family: typography.$font-heading;
			color: colors.$ivory;
			text-decoration: none;
			font-weight: typography.$weight-bold;
			font-size: typography.$font-size-xl;
			line-height: typography.$leading-tight;
			text-transform: uppercase;
			&[aria-current='page'] {
				color: colors.$amber;
			}
			&:hover {
				color: colors.$amber;
			}
			&:focus-visible {
				color: colors.$amber;
				outline: 2px solid colors.$amber;
				outline-offset: 2px;
			}
		}

		.nav-bottom {
			display: none;
		}

		.social-links {
			display: flex;
			gap: spacing.$space-4;
			align-items: center;
		}

		.social-link {
			display: block;
			color: colors.$ivory;
			&:hover {
				color: colors.$amber;
			}
		}

		@media (min-width: 768px) {
			width: layout.$nav-sidebar-width;
			flex-shrink: 0;
			position: sticky;
			top: 0;
			height: 100vh;
			overflow-y: auto;
			flex-direction: column;
			align-items: stretch;
			padding: spacing.$space-8;

			ul {
				flex-direction: column;
				gap: 0;
			}

			li a {
				font-size: typography.$font-size-4xl;
			}

			.nav-bottom {
				display: block;
				margin-top: auto;
				padding-top: spacing.$space-8;
			}
		}
	}
</style>
