---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Posts' },
	{ href: '/about', label: 'About' },
	// { href: '/uses', label: '/Uses' },
];
---

<nav aria-label='Primary Navigation'>
	<ul>
		{
			links.map(({ href, label }) => (
				<li>
					<a
						href={href}
						aria-current={
							pathname === href ||
							pathname === `${href}/` ||
							(href === '/blog' && pathname.startsWith('/posts/'))
								? 'page'
								: undefined
						}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
	<div class='site-identity'>
		<Logo aria-hidden='true' class='site-logo' />
		<p class='site-description'>Writing about music, technology, and whatever else.</p>
	</div>
</nav>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	nav {
		background-color: colors.$graphite;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: spacing.$space-4 spacing.$space-6;

		ul {
			padding: 0;
			margin: 0;
			display: flex;
			gap: spacing.$space-6;
			li {
				list-style: none;
			}
		}

		li a {
			font-family: typography.$font-heading;
			color: colors.$ivory;
			text-decoration: none;
			font-weight: typography.$weight-bold;
			font-size: typography.$font-size-xl;
			line-height: typography.$leading-tight;
			text-transform: uppercase;
			&[aria-current='page'] {
				color: colors.$amber;
			}
			&:hover {
				color: colors.$amber;
			}
			&:focus-visible {
				color: colors.$amber;
				outline: 2px solid colors.$amber;
				outline-offset: 2px;
			}
		}

		.site-identity {
			display: none;
		}

		:global(.site-logo) {
			display: block;
			width: 100%;
			height: auto;
			color: map.get(colors.$amber-tones, 'tone-1');
			// color: colors.$amber;
			margin-bottom: spacing.$space-3;
		}

		.site-description {
			font-family: typography.$font-body;
			font-size: typography.$font-size-sm;
			font-weight: typography.$weight-regular;
			color: map.get(colors.$ivory-tones, 'tone-3');
			margin: 0;
			line-height: typography.$leading-normal;
			text-wrap: balance;
		}

		@media (min-width: 768px) {
			width: layout.$nav-sidebar-width;
			flex-shrink: 0;
			position: sticky;
			top: 0;
			height: 100vh;
			overflow-y: auto;
			flex-direction: column;
			align-items: stretch;
			padding: spacing.$space-8;

			ul {
				flex-direction: column;
				gap: 0;
			}

			li a {
				font-size: typography.$font-size-4xl;
			}

			.site-identity {
				display: block;
				margin-top: auto;
				padding-top: spacing.$space-8;
			}
		}
	}
</style>
