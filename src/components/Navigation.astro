---
const pathname = Astro.url.pathname;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Blog' },
	// { href: '/about', label: 'About' },
	// { href: '/uses', label: 'Uses' },
];
---

<nav aria-label='Primary Navigation'>
	<ul>
		{
			links.map(({ href, label }) => (
				<li>
					<a href={href} aria-current={pathname === href || pathname === `${href}/` ? 'page' : undefined}>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style lang='scss'>
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	nav {
		width: 348px;
		flex-shrink: 0;
		position: sticky;
		top: 0;
		height: 100vh;
		overflow-y: auto;
		background-color: colors.$graphite;
		display: flex;
		flex-direction: column;
		padding: spacing.$space-8;
		ul {
			padding: 0;
			margin: 0;
			li {
				list-style: none;
			}
		}

		li a {
			font-family: typography.$font-body;
			color: colors.$ivory;
			text-decoration: none;
			font-weight: typography.$weight-extrabold;
			font-size: typography.$font-size-5xl;
			line-height: typography.$leading-tight;
			text-transform: uppercase;
			&[aria-current='page'] {
				color: colors.$amber;
			}
			&:hover {
				color: colors.$amber;
			}
			&:focus-visible {
				color: colors.$amber;
				outline: 2px solid colors.$amber;
				outline-offset: 2px;
			}
		}
	}
</style>
