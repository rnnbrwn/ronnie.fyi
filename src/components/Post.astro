---
import TagPills from './TagPills.astro';
import IconBlueSky from './IconBlueSky.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getPostUrl, formatDate, formatRelativeDate, formatShelfEventDate } from '../utils/getSortedPosts';
import type { BskyActor } from '../utils/bsky';
import BskyInteractors from './BskyInteractors.tsx';
import type { PostBase } from '../utils/types';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', { eager: true });

interface Props extends PostBase {
	description?: string;
	tags: string[];
	image?: { url: string; alt: string; source?: string };
	pinned?: boolean;
	isDigest?: boolean;
	isShelfEvent?: boolean;
	rating?: number;
	review?: string;
	href?: string;
	html?: string;
	relativeDate?: boolean;
	bskyPostUri?: string;
	bskyInteractors?: BskyActor[];
}

const {
	id,
	title,
	description,
	pubDate,
	tags,
	image,
	pinned = false,
	draft = false,
	isDigest = false,
	isShelfEvent = false,
	rating,
	review,
	href = getPostUrl(pubDate, id),
	html,
	relativeDate = false,
	bskyPostUri,
	bskyInteractors = [],
} = Astro.props;
---

<section class={`post${isDigest ? ' post--digest' : ''}${isShelfEvent ? ' post--shelf-event' : ''}`} aria-labelledby={`post-title-${id}`}>
	<h2 id={`post-title-${id}`}>
		{isDigest && <IconBlueSky class='bsky-icon' size={28} />}
		{isDigest
			? <span>{title}</span>
			: isShelfEvent
			? <a href={href}><span class='shelf-event-prefix'>Finished:</span> {title.replace(/^Finished:\s*/, '')}</a>
			: <a href={href}>{title}</a>
		}
	</h2>
	{isShelfEvent && (
		<time class='shelf-event-date' datetime={pubDate.toISOString()}>
			{formatShelfEventDate(pubDate)}
		</time>
	)}
	{draft && <div class='draft-flag'>Draft</div>}
	{pinned && <div class='highlight'>This is a pinned post</div>}
	<div class='post-body prose'>
		{
			image && imageFiles[`/src/assets/images/${image.url}`] && (
				<figure class='post-image'>
					<Image src={imageFiles[`/src/assets/images/${image.url}`]!.default} alt={image.alt} />
					{image.source && (
						<figcaption>
							<a href={image.source}>Image source</a>
						</figcaption>
					)}
				</figure>
			)
		}
		{description && <p>{description}</p>}
		{isShelfEvent && review && <p class='shelf-event-review'>{review}</p>}
		{html ? <Fragment set:html={html} /> : <slot />}
		{
			!isDigest && (
				<div class='post-meta'>
					{isShelfEvent && (
						<div class='shelf-event-rating'>
							{rating !== undefined && (
								<span aria-label={`Rating: ${rating} out of 5`}>
									{'★'.repeat(rating)}{'☆'.repeat(5 - rating)}
								</span>
							)}
							<a href='https://hardcover.app/@rnnbrwn/reviews'>More on Hardcover.app</a>
						</div>
					)}
					{!isShelfEvent && (
						<div class='published-date'>
							Posted{' '}
							<time datetime={pubDate.toISOString()}>
								{relativeDate ? formatRelativeDate(pubDate) : formatDate(pubDate)}
							</time>
						</div>
					)}
					{!isShelfEvent && <TagPills tags={tags} />}
					{!isShelfEvent && bskyPostUri && (
						<div class='bsky-interactions'>
							<BskyInteractors uri={bskyPostUri} initial={bskyInteractors} client:visible />
						</div>
					)}
				</div>
			)
		}
	</div>
</section>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/breakpoints';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';
	@use '../styles/abstracts/colors';

	h2 {
		font-weight: typography.$weight-medium;
		font-size: typography.$font-size-2xl;
		letter-spacing: typography.$tracking-normal;
		max-width: layout.$heading-max-width;

		@media (min-width: breakpoints.$md) {
			font-size: typography.$font-size-4xl;
		}
		color: colors.$dark;
		margin-top: 0;
		margin-bottom: spacing.$space-8;

		&:has(+ .highlight) {
			margin-bottom: spacing.$space-2;
		}
		position: relative;

		&::before,
		:global(.bsky-icon) {
			position: absolute;
			right: calc(100% + spacing.$space-3);
			display: none;

			@media (min-width: breakpoints.$md) {
				display: block;
			}
		}

		&::before {
			content: '#';
			color: colors.$primary;
			font-weight: typography.$weight-regular;
		}

		&:has(a:hover)::before {
			color: colors.$primary;
		}

		a {
			color: inherit;
			text-decoration: none;
			font-weight: inherit;

			&:visited {
				color: inherit;
			}

			&:hover {
				color: colors.$primary;
			}
		}

		:global(html[data-theme='dark']) &:has(a:hover)::before {
			color: colors.$primary;
		}

		:global(.bsky-icon) {
			width: spacing.$space-8;
			height: spacing.$space-8;
			color: colors.$tertiary;
		}

	}

	.post {
		margin-bottom: spacing.$space-24;

		&.post--digest {
			h2 {
				font-size: typography.$font-size-xl;
				color: map.get(colors.$dark-tones, 'tone-1');

				:global(html[data-theme='dark']) & {
					color: colors.$light;
				}

				@media (min-width: breakpoints.$md) {
					font-size: typography.$font-size-2xl;
				}

				&::before {
					display: none;
				}
			}

			.post-body {
				.published-date {
					color: map.get(colors.$dark-tones, 'tone-1');
				}

				.post-meta {
					margin-top: 0;
					padding-top: spacing.$space-10;
				}
			}
		}

		&.post--shelf-event {
			h2 {
				font-size: typography.$font-size-xl;
				font-weight: typography.$weight-regular;
				color: map.get(colors.$dark-tones, 'tone-1');
				text-transform: uppercase;
				margin-bottom: spacing.$space-1;

				:global(html[data-theme='dark']) & {
					color: colors.$light;
				}

				&::before {
					display: none;
				}

				.shelf-event-prefix {
					color: colors.$text-muted;
					font-weight: typography.$weight-regular;
				}
			}

			.shelf-event-date {
				@include typography.caption-text;
				display: block;
				font-weight: typography.$weight-bold;
				color: colors.$dark;
				margin-bottom: spacing.$space-3;

				:global(html[data-theme='dark']) & {
					color: colors.$light;
				}
			}

			.post-body {
				.post-meta {
					margin-top: 0;
					padding-top: 0;
				}

				.shelf-event-rating {
					display: flex;
					align-items: center;
					gap: spacing.$space-4;

					span {
						@include typography.meta-label;
						color: colors.$primary;
						letter-spacing: 2px;
					}

					a {
						@include typography.meta-label;
						color: colors.$text-muted;

						&:hover {
							color: colors.$primary;
						}
					}
				}
			}
		}
	}

	.draft-flag {
		position: relative;
		width: fit-content;
		color: colors.$light;
		padding: 0 spacing.$space-2;
		background-color: colors.$primary;
		@include typography.caption-text;
		font-weight: typography.$weight-bold;
		text-transform: uppercase;
		letter-spacing: typography.$tracking-wide;
	}

	.highlight {
		position: relative;
		width: fit-content;
		color: colors.$dark;
		padding: 0 spacing.$space-2;
		background-color: colors.$secondary;
		@include typography.caption-text;
		font-weight: typography.$weight-regular;
		text-transform: uppercase;
	}

	.post-body {
		@include typography.prose;
		border-bottom: spacing.$space-1 solid map.get(colors.$dark-tones, 'tone-5');
		padding-bottom: spacing.$space-24;

		.post-meta {
			margin-top: spacing.$space-8;
		}

		.published-date {
			@include typography.meta-label;
			color: colors.$text-muted;
			margin-bottom: spacing.$space-2;
		}

		.bsky-interactions {
			margin-top: spacing.$space-4;
		}
	}
</style>
