---
import { timeAgo } from '../utils/timeAgo';
import TagPills from './TagPills.astro';

interface Props {
	id: string;
	title: string;
	description?: string;
	pubDate: Date;
	tags: string[];
}

const { id, title, description, pubDate, tags } = Astro.props;
---

<section class='post'>
	<h2><a href={`/posts/${id}`}>{title}</a></h2>
	<div class='post-body'>
		<p>{description}</p>
		<slot />
		<div class='published-date'>Posted around <time datetime={pubDate.toISOString()}>{timeAgo(pubDate)}</time> in <TagPills tags={tags} /></div>
	</div>
</section>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';
	@use '../styles/abstracts/colors';

	h2 {
		font-weight: typography.$weight-bold;
		font-size: typography.$font-size-4xl;
		color: map.get(colors.$charcoal-tones, 'tone-2');
		margin-top: 0;
		margin-bottom: spacing.$space-8;
		text-wrap: balance;
		position: relative;

		&::before {
			content: '#';
			position: absolute;
			right: calc(100% + spacing.$space-3);
			color: colors.$amber;
			font-weight: typography.$weight-regular;
		}

		a {
			color: inherit;
			text-decoration: none;
			font-weight: inherit;

			&:visited {
				color: inherit;
			}

			&:hover {
				color: colors.$petrol;
			}
		}
	}

	.post {
		margin-bottom: spacing.$space-24;
	}

	.post-body {
		@include typography.prose;
		border-bottom: 1px solid colors.$charcoal;
		padding-bottom: spacing.$space-24;

		// Vertical rhythm between block elements
		:global(p),
		:global(ul),
		:global(ol),
		:global(blockquote),
		:global(pre),
		:global(.youtube-embed) {
			margin-bottom: spacing.$space-6;
			color: colors.$charcoal;
		}

		// Prose headings — size overrides only, base styles come from globals
		:global(h2) {
			font-size: typography.$font-size-2xl;
		}

		// Lists
		:global(ul),
		:global(ol) {
			padding-left: spacing.$space-6;
		}

		:global(li) {
			margin-bottom: spacing.$space-2;
		}

		// Blockquotes
		:global(blockquote) {
			padding-left: spacing.$space-6;
			border-left: 3px solid colors.$graphite;
			font-style: italic;
		}

		// Inline code
		:global(code) {
			font-family: typography.$font-mono;
			font-size: typography.$font-size-md;
		}

		:global(a:not(.tag-pill)) {
			color: colors.$teal;

			&:hover {
				color: colors.$petrol;
			}
		}

		// Code blocks
		:global(pre) {
			padding: spacing.$space-4;
			overflow-x: auto;
			font-size: typography.$font-size-md;
			line-height: typography.$leading-normal;
			border-radius: spacing.$space-2;
		}

		.published-date {
			@include typography.caption-text;
			// margin-top: spacing.$space-10;
			font-weight: typography.$weight-bold;
			color: map.get(colors.$charcoal-tones, 'tone-4');
		}
	}
</style>
