---
import TagPills from './TagPills.astro';
import IconPin from './IconPin.astro';
import IconBlueSky from './IconBlueSky.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getPostUrl, formatDate, formatRelativeDate } from '../utils/getSortedPosts';
import type { BskyActor } from '../utils/bsky';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', { eager: true });

interface Props {
	id: string;
	title: string;
	description?: string;
	pubDate: Date;
	tags: string[];
	image?: { url: string; alt: string; source?: string };
	pinned?: boolean;
	isDigest?: boolean;
	href?: string;
	html?: string;
	relativeDate?: boolean;
	bskyPostUri?: string;
	bskyInteractors?: BskyActor[];
}

const {
	id,
	title,
	description,
	pubDate,
	tags,
	image,
	pinned = false,
	isDigest = false,
	href = getPostUrl(pubDate, id),
	html,
	relativeDate = false,
	bskyPostUri,
	bskyInteractors = [],
} = Astro.props;
---

<section class={`post${isDigest ? ' post--digest' : ''}`} aria-labelledby={`post-title-${id}`}>
	<h2 id={`post-title-${id}`}>
		{isDigest && <IconBlueSky class='bsky-icon' size={28} />}
		{isDigest ? <span>{title}</span> : <a href={href}>{title}</a>}
		{pinned && <IconPin class='pin-icon' size={32} />}
	</h2>
	<div class='post-body prose'>
		{
			image && imageFiles[`/src/assets/images/${image.url}`] && (
				<figure class='post-image'>
					<Image src={imageFiles[`/src/assets/images/${image.url}`]!.default} alt={image.alt} />
					{image.source && (
						<figcaption>
							<a href={image.source}>Image source</a>
						</figcaption>
					)}
				</figure>
			)
		}
		<p>{description}</p>
		{html ? <Fragment set:html={html} /> : <slot />}
		{
			!isDigest && (
				<div class='post-meta'>
					<div class='published-date'>
						Posted{' '}
						<time datetime={pubDate.toISOString()}>
							{relativeDate ? formatRelativeDate(pubDate) : formatDate(pubDate)}
						</time>
					</div>
					<TagPills tags={tags} />
					{
						bskyPostUri && bskyInteractors.length > 0 && (
							<div class='bsky-interactions'>
								<div class='bsky-avatars'>
									{bskyInteractors.map((actor) =>
										actor.avatar ? (
											<a
												href={`https://bsky.app/profile/${actor.handle}`}
												target='_blank'
												rel='noopener noreferrer'
												title={actor.displayName ?? actor.handle}
											>
												<img src={actor.avatar} alt={actor.displayName ?? actor.handle} width='28' height='28' class='bsky-avatar' />
											</a>
										) : (
											<a
												href={`https://bsky.app/profile/${actor.handle}`}
												target='_blank'
												rel='noopener noreferrer'
												title={actor.displayName ?? actor.handle}
												class='bsky-avatar bsky-avatar--placeholder'
											>
												{(actor.displayName ?? actor.handle).charAt(0).toUpperCase()}
											</a>
										)
									)}
								</div>
							</div>
						)
					}
					{pinned && <p class='highlight'>This is a pinned post</p>}
				</div>
			)
		}
	</div>
</section>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/breakpoints';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';
	@use '../styles/abstracts/colors';

	h2 {
		font-weight: typography.$weight-bold;
		font-size: typography.$font-size-2xl;

		@media (min-width: breakpoints.$md) {
			font-size: typography.$font-size-4xl;
		}
		color: colors.$dark;
		margin-top: 0;
		margin-bottom: spacing.$space-8;
		text-wrap: balance;
		position: relative;

		&::before,
		:global(.bsky-icon) {
			position: absolute;
			right: calc(100% + spacing.$space-3);
			display: none;

			@media (min-width: breakpoints.$md) {
				display: block;
			}
		}

		&::before {
			content: '#';
			color: colors.$primary;
			font-weight: typography.$weight-regular;
		}

		a {
			color: inherit;
			text-decoration: none;
			font-weight: inherit;

			&:visited {
				color: inherit;
			}

			&:hover {
				color: colors.$tertiary;
			}
		}

		:global(.bsky-icon) {
			width: spacing.$space-8;
			height: spacing.$space-8;
			color: colors.$tertiary;
		}

		:global(.pin-icon) {
			display: inline-block;
			vertical-align: middle;
			color: map.get(colors.$dark-tones, 'tone-3');
			margin-left: spacing.$space-2;
			transform: rotate(25deg) translateY(-14px);
		}
	}

	.post {
		margin-bottom: spacing.$space-24;

		&.post--digest {
			h2 {
				font-size: typography.$font-size-xl;
				color: map.get(colors.$dark-tones, 'tone-1');

				@media (min-width: breakpoints.$md) {
					font-size: typography.$font-size-2xl;
				}

				&::before {
					display: none;
				}
			}

			.post-body {
				.published-date {
					color: map.get(colors.$dark-tones, 'tone-1');
				}

				.post-meta {
					margin-top: 0;
					padding-top: spacing.$space-10;
				}
			}
		}
	}

	.post-body {
		@include typography.prose;
		border-bottom: calc(spacing.$space-2 / 2) solid map.get(colors.$dark-tones, 'tone-5');
		padding-bottom: spacing.$space-24;

		.post-meta {
			margin-top: spacing.$space-8;
		}

		.highlight {
			position: relative;
			width: fit-content;

			&::before {
				content: '';
				position: absolute;
				inset: 0 (-(spacing.$space-2));
				background-color: colors.$secondary;
				transform: rotate(-2deg);
				z-index: -1;
			}
		}

		.published-date {
			@include typography.caption-text;
			font-weight: typography.$weight-regular;
			text-transform: uppercase;
			color: colors.$text-muted;
			margin-bottom: spacing.$space-2;
		}

		.bsky-interactions {
			margin-top: spacing.$space-4;
		}

		.bsky-avatars {
			display: flex;
			flex-wrap: wrap;
			gap: spacing.$space-1;
		}

		.bsky-avatar {
			display: block;
			width: 28px;
			height: 28px;
			border-radius: 50%;
			overflow: hidden;
			object-fit: cover;
			// override prose img defaults
			border-bottom: none;
			margin-bottom: 0;
		}

		:global(.bsky-avatar--placeholder) {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			border-radius: 50%;
			background-color: map.get(colors.$dark-tones, 'tone-4');
			color: colors.$light;
			font-size: typography.$font-size-sm;
			font-weight: typography.$weight-bold;
			text-decoration: none;
		}

	}

</style>
