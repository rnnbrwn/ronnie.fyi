---
import { timeAgo } from '../utils/timeAgo';
import TagPills from './TagPills.astro';
import IconPin from './IconPin.astro';
interface Props {
	id: string;
	title: string;
	description?: string;
	pubDate: Date;
	tags: string[];
	image?: { url: string; alt: string; source?: string };
	pinned?: boolean;
}

const { id, title, description, pubDate, tags, image, pinned = false } = Astro.props;
---

<section class='post' aria-labelledby={`post-title-${id}`}>
	<h2 id={`post-title-${id}`}>
		<a href={`/posts/${id}`}>{title}</a>
		{pinned && <IconPin class='pin-icon' size={48} />}
	</h2>
	<div class='post-body'>
		{
			image && (
				<figure class='post-image'>
					<img src={`images/${image.url}`} alt={image.alt} />
					{image.source && (
						<figcaption>
							Image source: <a href={image.source}>{image.source}</a>
						</figcaption>
					)}
				</figure>
			)
		}
		<p>{description}</p>
		<slot />
		<div class='post-meta'>
			<div class='published-date'>
				Posted <time datetime={pubDate.toISOString()}>{timeAgo(pubDate)}</time>
			</div>
			<TagPills tags={tags} />
			{pinned && <p class='featured-label'>featured post</p>}
		</div>
	</div>
</section>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';
	@use '../styles/abstracts/colors';

	h2 {
		font-weight: typography.$weight-bold;
		font-size: typography.$font-size-2xl;

		@media (min-width: 768px) {
			font-size: typography.$font-size-4xl;
		}
		color: colors.$graphite;
		margin-top: 0;
		margin-bottom: spacing.$space-8;
		text-wrap: balance;
		position: relative;

		&::before {
			content: '#';
			position: absolute;
			right: calc(100% + spacing.$space-3);
			color: colors.$amber;
			font-weight: typography.$weight-regular;
		}

		a {
			color: inherit;
			text-decoration: none;
			font-weight: inherit;

			&:visited {
				color: inherit;
			}

			&:hover {
				color: colors.$petrol;
			}
		}

		:global(.pin-icon) {
			display: inline-block;
			vertical-align: middle;
			color: colors.$red;
			margin-left: spacing.$space-2;
			transform: rotate(35deg) translateY(-10px);
		}
	}

	.post {
		margin-bottom: spacing.$space-24;
	}

	.post-image {
		margin: 0 0 spacing.$space-6;

		img {
			display: block;
			width: 100%;
			height: auto;
			border-bottom: spacing.$space-2 solid colors.$amber;
		}

		figcaption {
			@include typography.caption-text;
			color: map.get(colors.$graphite-tones, 'tone-2');
			margin-top: spacing.$space-2;

			a {
				color: inherit;
			}
		}
	}

	.post-body {
		@include typography.prose;
		border-bottom: 1px solid colors.$graphite;
		padding-bottom: spacing.$space-24;

		// Vertical rhythm between block elements
		:global(p),
		:global(ul),
		:global(ol),
		:global(blockquote),
		:global(pre),
		:global(.youtube-embed) {
			margin-bottom: spacing.$space-6;
			color: colors.$graphite;
		}

		// Prose headings — size overrides only, base styles come from globals
		:global(h2) {
			font-size: typography.$font-size-2xl;
		}

		// Lists
		:global(ul),
		:global(ol) {
			padding-left: spacing.$space-6;
		}

		:global(li) {
			margin-bottom: spacing.$space-2;
		}

		// Blockquotes
		:global(blockquote) {
			padding-left: spacing.$space-6;
			border-left: 3px solid colors.$graphite;
			font-style: italic;
		}

		// Inline code
		:global(code) {
			font-family: typography.$font-mono;
			font-size: typography.$font-size-md;
		}

		:global(a:not(.tag-pill)) {
			color: colors.$petrol;

			&:hover {
				text-decoration: none;
			}
		}

		// Code blocks
		:global(pre) {
			padding: spacing.$space-4;
			overflow-x: auto;
			font-size: typography.$font-size-md;
			line-height: typography.$leading-normal;
			border-radius: spacing.$space-2;
		}

		.post-meta {
			margin-top: spacing.$space-8;
		}

		.featured-label {
			display: block;
			width: fit-content;
			margin-top: spacing.$space-2;
			font-size: typography.$font-size-sm;
			font-weight: typography.$weight-semibold;
			text-transform: uppercase;
			background-color: colors.$red;
			color: colors.$ivory;
			padding: spacing.$space-1 spacing.$space-3;
		}

		.published-date {
			@include typography.caption-text;
			font-weight: typography.$weight-bold;
			color: colors.$graphite;
			margin-bottom: spacing.$space-2;
		}
	}
</style>
