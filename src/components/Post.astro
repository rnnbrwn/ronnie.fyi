---
import TagPills from './TagPills.astro';
import IconPin from './IconPin.astro';
import IconBlueSky from './IconBlueSky.astro';
interface Props {
	id: string;
	title: string;
	description?: string;
	pubDate: Date;
	tags: string[];
	image?: { url: string; alt: string; source?: string };
	pinned?: boolean;
	isDigest?: boolean;
	href?: string;
}

const { id, title, description, pubDate, tags, image, pinned = false, isDigest = false, href = `/posts/${id}` } = Astro.props;
---

<section class={`post${isDigest ? ' post--digest' : ''}`} aria-labelledby={`post-title-${id}`}>
	<h2 id={`post-title-${id}`}>
		{isDigest && <IconBlueSky class='bsky-icon' size={28} />}
		{isDigest ? <span>{title}</span> : <a href={href}>{title}</a>}
		{pinned && <IconPin class='pin-icon' size={32} />}
	</h2>
	<div class='post-body prose'>
		{
			image && (
				<figure class='post-image'>
					<img src={`images/${image.url}`} alt={image.alt} />
					{image.source && (
						<figcaption>
							Image source: <a href={image.source}>{image.source}</a>
						</figcaption>
					)}
				</figure>
			)
		}
		<p>{description}</p>
		<slot />
		{!isDigest && <div class='post-meta'>
			<div class='published-date'>
				Posted <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
			</div>
			<TagPills tags={tags} />
			{pinned && <p class='featured-label'>featured post</p>}
		</div>}
	</div>
</section>

<style lang='scss'>
	@use 'sass:map';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';
	@use '../styles/abstracts/colors';

	h2 {
		font-weight: typography.$weight-bold;
		font-size: typography.$font-size-2xl;

		@media (min-width: 768px) {
			font-size: typography.$font-size-4xl;
		}
		color: colors.$graphite;
		margin-top: 0;
		margin-bottom: spacing.$space-8;
		text-wrap: balance;
		position: relative;

		&::before {
			content: '#';
			position: absolute;
			right: calc(100% + spacing.$space-3);
			color: colors.$amber;
			font-weight: typography.$weight-regular;
		}

		a {
			color: inherit;
			text-decoration: none;
			font-weight: inherit;

			&:visited {
				color: inherit;
			}

			&:hover {
				color: colors.$petrol;
			}
		}

		:global(.bsky-icon) {
			position: absolute;
			right: calc(100% + spacing.$space-3);
			top: 0.15em;
			width: 28px;
			height: 28px;
			color: colors.$teal;
		}

		:global(.pin-icon) {
			display: inline-block;
			vertical-align: middle;
			color: colors.$red;
			margin-left: spacing.$space-2;
			transform: rotate(25deg) translateY(-14px);
		}
	}

	.post {
		margin-bottom: spacing.$space-24;

		&.post--digest {
			h2 {
				font-size: typography.$font-size-xl;
				color: map.get(colors.$graphite-tones, 'tone-1');

				@media (min-width: 768px) {
					font-size: typography.$font-size-2xl;
				}

				&::before {
					display: none;
				}
			}

			.post-body {
				.published-date {
					color: map.get(colors.$graphite-tones, 'tone-1');
				}

				.post-meta {
					margin-top: 0;
					padding-top: spacing.$space-10;
				}

				:global(.skeet) {
					display: grid;
					grid-template-columns: 48px 1fr;
					column-gap: spacing.$space-3;
					padding-block: spacing.$space-5;
					border-bottom: 1px solid map.get(colors.$graphite-tones, 'tone-4');

					&:last-of-type {
						border-bottom: none;
						padding-bottom: 0;
					}
				}

				:global(.skeet-author-avatar) {
					display: block;
					width: 48px;
					height: 48px;
					border-radius: 50%;
					overflow: hidden;

					img {
						display: block;
						width: 100%;
						height: 100%;
						object-fit: cover;
						object-position: 50% 50%;
						border-bottom: none;
					}
				}

				:global(.skeet-main) {
					min-width: 0;
				}

				:global(.skeet-header) {
					display: flex;
					align-items: baseline;
					gap: spacing.$space-2;
					margin-bottom: spacing.$space-2;
					flex-wrap: wrap;
				}

				:global(.skeet-display-name) {
					font-weight: typography.$weight-bold;
					color: colors.$graphite;
					text-decoration: none;

					&:hover {
						color: colors.$teal;
					}

					&:visited {
						color: colors.$graphite;
					}
				}

				:global(.skeet-handle) {
					color: map.get(colors.$graphite-tones, 'tone-2');
					font-size: typography.$font-size-sm;
				}

				:global(.skeet-timestamp) {
					margin-left: auto;
					color: map.get(colors.$graphite-tones, 'tone-2');
					font-size: typography.$font-size-sm;
					text-decoration: none;
					white-space: nowrap;

					&:hover {
						color: colors.$teal;
					}
				}

				:global(.skeet-body) {
					color: map.get(colors.$graphite-tones, 'tone-1');
				}

				:global(.skeet-body p) {
					margin-block: spacing.$space-2;

					&:first-child {
						margin-top: 0;
					}

					&:last-child {
						margin-bottom: 0;
					}
				}

				:global(.skeet-quote) {
					margin-top: spacing.$space-3;
					border: 1px solid map.get(colors.$graphite-tones, 'tone-3');
					border-radius: 8px;
					padding: spacing.$space-4;
				}

				:global(.skeet-quote-header) {
					display: flex;
					align-items: center;
					gap: spacing.$space-2;
					margin-bottom: spacing.$space-2;
				}

				:global(.skeet-quote-avatar) {
					display: block;
					width: 20px;
					height: 20px;
					border-radius: 50%;
					object-fit: cover;
					object-position: 50% 50%;
					flex-shrink: 0;
					border-bottom: none;
				}

				:global(.skeet-quote-name) {
					font-weight: typography.$weight-bold;
					font-size: typography.$font-size-sm;
					color: colors.$graphite;
					text-decoration: none;

					&:hover {
						color: colors.$teal;
					}
				}

				:global(.skeet-quote-handle) {
					font-size: typography.$font-size-sm;
					color: map.get(colors.$graphite-tones, 'tone-2');
				}

				:global(.skeet-quote-body) {
					font-size: typography.$font-size-sm;
					color: map.get(colors.$graphite-tones, 'tone-1');
				}

				:global(.skeet-quote-body p) {
					margin-block: spacing.$space-1;

					&:first-child {
						margin-top: 0;
					}

					&:last-child {
						margin-bottom: 0;
					}
				}

				:global(.skeet-quote-link) {
					display: flex;
					flex-direction: column;
					margin-top: spacing.$space-2;
					padding: spacing.$space-3;
					border: 1px solid map.get(colors.$graphite-tones, 'tone-4');
					border-radius: 4px;
					font-size: typography.$font-size-sm;

					a {
						font-weight: typography.$weight-semibold;
						color: colors.$graphite;
						text-decoration: none;

						&:hover {
							color: colors.$teal;
						}
					}
				}

				:global(.skeet-quote-link-desc) {
					color: map.get(colors.$graphite-tones, 'tone-2');
					font-size: typography.$font-size-sm;
					margin-top: spacing.$space-1;
				}

				:global(.skeet-footer) {
					margin-top: spacing.$space-3;
				}

				:global(.bsky-likes) {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					gap: spacing.$space-2;
					margin: 0;
				}

				:global(.bsky-avatar) {
					display: inline-block;
					position: relative;
					width: 28px;
					height: 28px;
					border-radius: 50%;
					overflow: hidden;
					vertical-align: middle;
					margin-left: -10px;
					box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.35);

					&:first-of-type {
						margin-left: 0;
					}

					img {
						position: absolute;
						top: 0;
						left: 0;
						width: 100%;
						height: 100%;
						object-fit: cover;
						object-position: 50% 50%;
						border-bottom: none;
					}
				}
			}
		}
	}

	.post-image {
		margin: 0 0 spacing.$space-6;

		img {
			display: block;
			width: 100%;
			height: auto;
			border-bottom: spacing.$space-2 solid colors.$amber;
		}

		figcaption {
			@include typography.caption-text;
			color: map.get(colors.$graphite-tones, 'tone-1');
			margin-top: spacing.$space-2;

			a {
				color: inherit;
			}
		}
	}

	.post-body {
		@include typography.prose;
		border-bottom: 1px solid colors.$graphite;
		padding-bottom: spacing.$space-24;

		.post-meta {
			margin-top: spacing.$space-8;
		}

		.featured-label {
			display: block;
			width: fit-content;
			margin-top: spacing.$space-2;
			font-size: typography.$font-size-sm;
			font-weight: typography.$weight-semibold;
			text-transform: uppercase;
			background-color: colors.$red;
			color: colors.$ivory;
			padding: spacing.$space-1 spacing.$space-3;
		}

		.published-date {
			@include typography.caption-text;
			font-weight: typography.$weight-regular;
			text-transform: uppercase;
			color: map.get(colors.$graphite-tones, 'tone-2');
			margin-bottom: spacing.$space-2;
		}
	}
</style>
