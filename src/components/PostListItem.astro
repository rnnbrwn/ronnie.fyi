---
import IconClock from './IconClock.astro';
import { getPostUrl, formatDateShort, formatShelfEventDate } from '../utils/getSortedPosts';
import type { PostBase } from '../utils/types';

interface Props extends PostBase {
	description?: string;
	stale?: boolean;
	isShelfEvent?: boolean;
	href?: string;
}

const { id, title, pubDate, description, stale = false, draft = false, isShelfEvent = false, href } = Astro.props;
---

<li class={isShelfEvent ? 'shelf-event' : undefined}>
	<a href={href ?? getPostUrl(pubDate, id)}>
		{isShelfEvent
			? <><span class='shelf-event-prefix'>Finished:</span> {title.replace(/^Finished:\s*/, '')}</>
			: title
		}
		{stale && <IconClock class='stale-icon' size={20} />}
		{draft && <span class='draft-badge'>Draft</span>}
	</a>
	<time datetime={pubDate.toISOString()}>
		{isShelfEvent ? formatShelfEventDate(pubDate) : formatDateShort(pubDate)}
	</time>
	{description && <p>{description}</p>}
</li>

<style lang='scss'>
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	li {
		margin-block-end: spacing.$space-8;
	}

	time {
		@include typography.caption-text;
		display: block;
		font-weight: typography.$weight-bold;
		color: colors.$dark;
		margin-bottom: spacing.$space-1;

		:global(html[data-theme='dark']) & {
			color: colors.$light;
		}
	}

	.draft-badge {
		display: inline-block;
		vertical-align: middle;
		font-size: typography.$font-size-sm;
		font-weight: typography.$weight-bold;
		text-transform: uppercase;
		letter-spacing: typography.$tracking-wide;
		color: colors.$light;
		background-color: colors.$primary;
		padding: 0 spacing.$space-1;
		margin-left: spacing.$space-2;
		transform: translateY(-2px);
	}

	:global(.stale-icon) {
		display: inline-block !important;
		vertical-align: middle;
		color: colors.$text-muted;
		margin-left: spacing.$space-2;
		transform: translateY(-5px);
	}

	a {
		display: inline-block;
		font-size: typography.$font-size-xl;
		font-weight: typography.$weight-medium;
		@include layout.body-link-full;
		margin-bottom: spacing.$space-1;
	}

	li.shelf-event a {
		font-size: typography.$font-size-lg;
		font-weight: typography.$weight-regular;
		text-transform: uppercase;

		.shelf-event-prefix {
			color: colors.$text-muted;
		}
	}

p {
		font-size: typography.$font-size-lg;
		color: colors.$text-muted;
		margin: 0;
		line-height: typography.$leading-normal;
		max-width: layout.$prose-width;
	}
</style>
