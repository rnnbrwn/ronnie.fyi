---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

<span class='tag-pills'>
	{tags.map((tag, i) => (
		<><a class='tag-pill' href={`/tags/${tag}`}>{tag}</a>{i < tags.length - 1 ? ', ' : ''}</>
	))}
</span>

<style lang='scss'>
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	.tag-pills,
	.tag-pill {
		display: inline;
	}

	.tag-pill {
		@include typography.caption-text;
		font-family: typography.$font-body;
		font-weight: typography.$weight-bold;
		text-transform: uppercase;
		color: colors.$petrol;
		text-decoration: underline;
		padding-block: spacing.$space-2;

		&:visited {
			color: colors.$petrol;
		}

		&:hover,
		&:visited:hover {
			color: colors.$teal;
		}
	}
</style>
