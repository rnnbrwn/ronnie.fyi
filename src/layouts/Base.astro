---
import Head from '../components/Head.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import 'modern-css-reset/dist/reset.min.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<Head title={title} description={description} />
	</head>
	<body>
		<a href='#main-content' class='skip-link'>Skip to main content</a>
		<Navigation />
		<div class='content'>
			<main id='main-content'>
				<slot />
			</main>
			<Footer />
		</div>

		<style lang='scss'>
			@use 'sass:map';
			@use '../styles/abstracts/colors';
			@use '../styles/abstracts/typography';
			@use '../styles/abstracts/spacing';

			body {
				font-family: typography.$font-body;
				background-color: map.get(colors.$ivory-tones, 'tone-5');
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
			.content {
				display: flex;
				flex-direction: column;
				flex: 1;
				min-width: 0;
			}
			main {
				flex: 1;
				padding: spacing.$space-6 spacing.$space-4;
				overflow-x: hidden;
			}
			@media (min-width: 768px) {
				body {
					flex-direction: row;
				}
				main {
					padding: spacing.$space-8 spacing.$space-24;
				}
			}
		</style>

		<style is:global lang='scss'>
			@use 'sass:map';
			@use '../styles/abstracts/colors';
			@use '../styles/abstracts/spacing';
			@use '../styles/abstracts/typography';

			a {
				color: colors.$petrol;
				font-weight: typography.$weight-semibold;
			}

			a:visited {
				color: colors.$petrol;
			}

			a:hover {
				color: colors.$petrol;
			}

			a:focus-visible {
				outline: 2px solid colors.$charcoal;
				outline-offset: 2px;
				box-shadow: 0 0 0 4px colors.$amber;
			}

			nav a {
				text-decoration: none;
			}

			nav a:focus-visible {
				outline: 2px solid colors.$amber;
				outline-offset: 2px;
				box-shadow: none;
			}

			.skip-link:not(:focus) {
				position: absolute;
				transform: translateY(-100%);
			}

			.skip-link:focus {
				position: fixed;
				top: 0;
				left: 0;
				background: colors.$charcoal;
				color: colors.$ivory;
				padding: spacing.$space-2 spacing.$space-4;
				font-family: typography.$font-body;
				z-index: 9999;
			}

			h1 {
				font-weight: typography.$weight-extrabold;
				font-size: typography.$font-size-3xl;
				color: colors.$graphite;
				line-height: typography.$leading-tight;
				margin-bottom: spacing.$space-6;
				text-wrap: balance;
			}
			@media (min-width: 768px) {
				h1 {
					font-size: typography.$font-size-5xl;
					margin-bottom: spacing.$space-8;
				}
			}

			h2 {
				font-weight: typography.$weight-bold;
				font-size: typography.$font-size-xl;
				line-height: typography.$leading-tight;
				color: colors.$petrol;
				margin-top: spacing.$space-10;
				margin-bottom: spacing.$space-4;
			}

			h3 {
				font-weight: typography.$weight-bold;
				font-size: typography.$font-size-lg;
				line-height: typography.$leading-tight;
				color: colors.$graphite;
				margin-top: spacing.$space-10;
				margin-bottom: spacing.$space-4;
			}
		</style>
	</body>
</html>
