---
import Head from '../components/Head.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import 'modern-css-reset/dist/reset.min.css';
import '../styles/main.scss';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = stored || preferred;
			})();
		</script>
		<link rel='preload' href='/fonts/Geomanist-Bold.otf' as='font' type='font/otf' crossorigin />
		<link rel='preload' href='/fonts/Geomanist-Medium.otf' as='font' type='font/otf' crossorigin />
		<Head title={title} description={description} ogImage={ogImage} />
		<link rel='sitemap' href='/sitemap-index.xml' />
	</head>

	<body>
		<a href='#main-content' class='skip-link'>Skip to main content</a>
		<Navigation />
		<div class='content'>
			<main id='main-content'>
				<slot />
			</main>
			<Footer />
		</div>

		<style lang='scss'>
			@use 'sass:map';
			@use '../styles/abstracts/breakpoints';
			@use '../styles/abstracts/colors';
			@use '../styles/abstracts/layout';
			@use '../styles/abstracts/typography';
			@use '../styles/abstracts/spacing';

			body {
				font-family: typography.$font-body;
				background-color: map.get(colors.$light-tones, 'tone-5');
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
			.content {
				display: flex;
				flex-direction: column;
				flex: 1;
				min-width: 0;
			}
			main {
				flex: 1;
				padding: spacing.$space-6 spacing.$space-4;
				overflow-x: hidden;
				font-size: typography.$font-size-lg;
			}
			@media (min-width: breakpoints.$md) {
				body {
					flex-direction: row;
				}
				main {
					padding: spacing.$space-8 spacing.$space-24;
				}
			}
		</style>

		<style is:global lang='scss'>
			@use 'sass:map';
			@use '../styles/abstracts/colors';
			@use '../styles/abstracts/layout';
			@use '../styles/abstracts/spacing';
			@use '../styles/abstracts/typography';

			a {
				color: colors.$tertiary;
				font-weight: typography.$weight-semibold;
			}

			a:visited {
				color: colors.$tertiary;
			}

			a:hover {
				color: colors.$tertiary;
			}

			a:focus-visible {
				@include layout.focus-ring(colors.$dark, colors.$primary);
			}

			nav a {
				text-decoration: none;
			}

			nav a:focus-visible {
				@include layout.focus-ring(colors.$primary);
			}

			.skip-link:not(:focus) {
				position: absolute;
				transform: translateY(-100%);
			}

			.skip-link:focus {
				position: fixed;
				top: 0;
				left: 0;
				background: colors.$dark;
				color: colors.$light;
				padding: spacing.$space-2 spacing.$space-4;
				font-family: typography.$font-body;
				z-index: 9999;
			}
		</style>
	</body>
</html>
