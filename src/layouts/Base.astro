---
import Head from '../components/Head.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import 'modern-css-reset/dist/reset.min.css';
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<Head />
	</head>
	<body class='stack'>
		<a href='#main-content' class='skip-link'>Skip to main content</a>
		<Navigation />
		<main id='main-content'>
			<slot />
		</main>
		<Footer />

		<style lang='scss'>
			@use '../styles/abstracts/colors';
			@use '../styles/abstracts/typography';

			body {
				font-family: typography.$font-body;
				min-height: 100vh;
				display: flex;

				aside {
					width: 348px;
					background-color: colors.$graphite;
					display: flex;
					flex-direction: column;
				}
			}
		</style>

		<style is:global lang='scss'>
			@use '../styles/abstracts/colors';
			@use '../styles/abstracts/spacing';
			@use '../styles/abstracts/typography';

			a {
				color: colors.$petrol;
			}

			a:visited {
				color: colors.$petrol;
			}

			a:hover {
				text-decoration: none;
			}

			a:focus-visible {
				outline: 2px solid colors.$charcoal;
				outline-offset: 2px;
				box-shadow: 0 0 0 4px colors.$amber;
			}

			nav a {
				text-decoration: none;
			}

			nav a:focus-visible {
				outline: 2px solid colors.$amber;
				outline-offset: 2px;
				box-shadow: none;
			}

			.skip-link {
				position: absolute;
				top: -9999px;
				left: -9999px;
			}

			.skip-link:focus {
				top: 0;
				left: 0;
				background: colors.$charcoal;
				color: colors.$ivory;
				padding: spacing.$space-2 spacing.$space-4;
				font-family: typography.$font-body;
				z-index: 9999;
			}
		</style>
	</body>
</html>
