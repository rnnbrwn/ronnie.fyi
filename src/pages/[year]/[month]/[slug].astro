---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TagPills from '../../../components/TagPills.astro';
import IconBlueSky from '../../../components/IconBlueSky.astro';
import IconClock from '../../../components/IconClock.astro';
import { Image } from 'astro:assets';
import { formatDate, formatMonthYear } from '../../../utils/getSortedPosts';
import type { ImageMetadata } from 'astro';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', { eager: true });

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => {
		const year = String(post.data.pubDate.getFullYear());
		const month = String(post.data.pubDate.getMonth() + 1).padStart(2, '0');
		return {
			params: { year, month, slug: post.id },
			props: { post },
		};
	});
}

const { post } = Astro.props;
const { year, month } = Astro.params;
const { Content } = await render(post);

interface BskyActor {
	did: string;
	handle: string;
	displayName?: string;
	avatar?: string;
}

let bskyInteractors: BskyActor[] = [];

if (post.data.bskyPostUri) {
	const uri = encodeURIComponent(post.data.bskyPostUri);
	const base = 'https://public.api.bsky.app/xrpc';
	const seen = new Set<string>();

	try {
		const [likesRes, repostsRes] = await Promise.all([
			fetch(`${base}/app.bsky.feed.getLikes?uri=${uri}&limit=100`),
			fetch(`${base}/app.bsky.feed.getRepostedBy?uri=${uri}&limit=100`),
		]);

		if (likesRes.ok) {
			const data = await likesRes.json();
			for (const like of data.likes ?? []) {
				if (!seen.has(like.actor.did)) {
					seen.add(like.actor.did);
					bskyInteractors.push(like.actor);
				}
			}
		}
		if (repostsRes.ok) {
			const data = await repostsRes.json();
			for (const actor of data.repostedBy ?? []) {
				if (!seen.has(actor.did)) {
					seen.add(actor.did);
					bskyInteractors.push(actor);
				}
			}
		}
	} catch {
		// silently skip if fetch fails at build time
	}
}

const ogImage = post.data.image?.url
	? new URL(`/og/${post.id}.png`, Astro.site).href
	: undefined;

const monthLabel = formatMonthYear(post.data.pubDate);
---

<Base title={post.data.title} description={post.data.description} ogImage={ogImage}>
	<article aria-labelledby='post-title'>
		<h1 id='post-title'>{post.data.title}</h1>
		{
			post.data.stale && (
				<p class='stale-warning'>
					<IconClock size={20} /> This post is now outdated, don't believe a word of it.
				</p>
			)
		}
		{
			post.data.image && imageFiles[`/src/assets/images/${post.data.image.url}`] && (
				<figure class='post-image'>
					<Image
						src={imageFiles[`/src/assets/images/${post.data.image.url}`]!.default}
						alt={post.data.image.alt}
					/>
					{post.data.image.source && (
						<figcaption>
							Image source: <a href={post.data.image.source}>{post.data.image.source.length > 80 ? post.data.image.source.slice(0, 80) + '…' : post.data.image.source}</a>
						</figcaption>
					)}
				</figure>
			)
		}
		<div class='post-body'>
			<div class='prose'>
				<Content />
			</div>
			<aside class='post-aside'>
				<div class='post-meta'>
					<div class='published-date'>
						Posted <time datetime={post.data.pubDate.toISOString()}
							>{
								formatDate(post.data.pubDate)
							}</time
						>
					</div>
					<TagPills tags={post.data.tags} />
					{
						bskyInteractors.length > 0 && (
							<div class='bsky-interactions'>
								<a
									href={`https://bsky.app/profile/${post.data.bskyPostUri!.split('/')[2]}/post/${post.data.bskyPostUri!.split('/').at(-1)}`}
									class='bsky-interactions-label'
									target='_blank'
									rel='noopener noreferrer'
								>
									<IconBlueSky size={14} />
									{bskyInteractors.length} {bskyInteractors.length === 1 ? 'person' : 'people'}
								</a>
								<div class='bsky-avatars'>
									{bskyInteractors.map((actor) =>
										actor.avatar ? (
											<a
												href={`https://bsky.app/profile/${actor.handle}`}
												target='_blank'
												rel='noopener noreferrer'
												title={actor.displayName ?? actor.handle}
											>
												<img src={actor.avatar} alt={actor.displayName ?? actor.handle} width='28' height='28' class='bsky-avatar' />
											</a>
										) : (
											<a
												href={`https://bsky.app/profile/${actor.handle}`}
												target='_blank'
												rel='noopener noreferrer'
												title={actor.displayName ?? actor.handle}
												class='bsky-avatar bsky-avatar--placeholder'
											>
												{(actor.displayName ?? actor.handle).charAt(0).toUpperCase()}
											</a>
										)
									)}
								</div>
							</div>
						)
					}
				</div>
				<div class='aside-links'>
					<a href='/posts' class='back-link'>All posts</a>
					<a href={`/${year}/${month}`} class='month-link'>{monthLabel}</a>
					<a href='/tags' class='tags-link'>All tags</a>
				</div>
			</aside>
		</div>
	</article>
</Base>

<style lang='scss'>
	@use 'sass:map';
	@use 'sass:color';
	@use '../../../styles/abstracts/breakpoints';
	@use '../../../styles/abstracts/layout';
	@use '../../../styles/abstracts/spacing';
	@use '../../../styles/abstracts/typography';
	@use '../../../styles/abstracts/colors';

	$sidebar-width: 220px;
	$body-gap: spacing.$space-12;

	article {
		margin: 0;
		padding: 0;
	}

	.stale-warning {
		display: flex;
		align-items: center;
		gap: spacing.$space-2;
		color: colors.$text-muted;
		font-weight: typography.$weight-semibold;
		margin-bottom: spacing.$space-6;
	}

	.post-image {
		margin: spacing.$space-6 0 0 0;
		max-width: layout.$prose-width;

		@media (min-width: breakpoints.$lg) {
			max-width: calc(#{layout.$prose-width} + #{$body-gap} + #{$sidebar-width});
		}

		img {
			display: block;
			width: 100%;
			height: auto;
			border-bottom: spacing.$space-2 solid colors.$primary;
		}

		figcaption {
			@include typography.caption-text;
			color: colors.$dark;
			margin-top: spacing.$space-2;

			:global(html[data-theme='dark']) & {
				color: colors.$light;
			}

			a {
				@include layout.tertiary-link;
			}

			:global(html[data-theme='dark']) & a {
				@include layout.tertiary-link-on-dark;
			}
		}
	}

	.post-body {
		margin-top: spacing.$space-16;

		@media (min-width: breakpoints.$lg) {
			display: grid;
			grid-template-columns: minmax(0, layout.$prose-width) $sidebar-width;
			gap: $body-gap;
			align-items: start;
			max-width: calc(#{layout.$prose-width} + #{$body-gap} + #{$sidebar-width});
		}
	}

	.prose {
		@include typography.prose;
	}

	.post-meta {
		margin-top: spacing.$space-6;

		@media (min-width: breakpoints.$lg) {
			margin-top: 0;
		}
	}

	.published-date {
		@include typography.caption-text;
		font-weight: typography.$weight-regular;
		text-transform: uppercase;
		color: colors.$text-muted;
		margin-bottom: spacing.$space-2;

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');
		}
	}

	.bsky-interactions {
		margin-top: spacing.$space-4;
	}

	.bsky-interactions-label {
		display: inline-flex;
		align-items: center;
		gap: spacing.$space-1;
		@include typography.caption-text;
		font-weight: typography.$weight-regular;
		text-transform: uppercase;
		color: colors.$text-muted;
		text-decoration: none;
		margin-bottom: spacing.$space-2;

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');
		}

		&:hover {
			color: colors.$tertiary;
		}
	}

	.bsky-avatars {
		display: flex;
		flex-wrap: wrap;
		gap: spacing.$space-1;
	}

	.bsky-avatar {
		display: block;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		overflow: hidden;
		object-fit: cover;
	}

	:global(.bsky-avatar--placeholder) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background-color: map.get(colors.$dark-tones, 'tone-4');
		color: colors.$light;
		font-size: typography.$font-size-xs;
		font-weight: typography.$weight-bold;
		text-decoration: none;
	}

	.aside-links {
		display: flex;
		flex-direction: column;
		gap: spacing.$space-3;
		margin-top: spacing.$space-6;
		padding-top: spacing.$space-6;
		border-top: calc(spacing.$space-2 / 2) solid map.get(colors.$dark-tones, 'tone-5');
	}

	.back-link,
	.month-link,
	.tags-link {
		font-family: typography.$font-body;
		font-size: typography.$font-size-md;
		font-weight: typography.$weight-bold;
		@include layout.tertiary-link;

		:global(html[data-theme='dark']) & {
			@include layout.tertiary-link-on-dark;
		}
	}
</style>
