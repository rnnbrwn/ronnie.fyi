---
import { getCollection, render } from 'astro:content';
import { getShelf } from '../../../utils/hardcover';
import Base from '../../../layouts/Base.astro';
import TagPills from '../../../components/TagPills.astro';
import IconClock from '../../../components/IconClock.astro';
import { Image } from 'astro:assets';
import { formatDate, formatMonthYear, getPostUrl } from '../../../utils/getSortedPosts';
import { fetchBskyInteractors } from '../../../utils/bsky';
import type { BskyActor } from '../../../utils/bsky';
import BskyInteractors from '../../../components/BskyInteractors.tsx';
import type { ImageMetadata } from 'astro';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', { eager: true });

export async function getStaticPaths() {
	const now = new Date();
	const posts = (await getCollection('blog'))
		.filter((p) => new Date(p.data.pubDate) <= now)
		.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

	const { currentlyReading, readByYear } = await getShelf();
	const allShelfBooks = [...currentlyReading, ...[...readByYear.values()].flat()];
	const bookById = new Map(allShelfBooks.map((ub) => [ub.book.id, { id: ub.book.id, title: ub.book.title }]));

	return posts.map((post, index) => {
		const year = String(post.data.pubDate.getFullYear());
		const month = String(post.data.pubDate.getMonth() + 1).padStart(2, '0');
		const prev = posts[index + 1];
		const next = posts[index - 1];
		const shelfBooks = (post.data.hardcoverIds ?? []).map((id) => bookById.get(id)).filter((b) => b != null);
		return {
			params: { year, month, slug: post.id },
			props: {
				post,
				prevPost: prev ? { url: getPostUrl(prev.data.pubDate, prev.id), title: prev.data.title } : null,
				nextPost: next ? { url: getPostUrl(next.data.pubDate, next.id), title: next.data.title } : null,
				shelfBooks,
			},
		};
	});
}

const { post, prevPost, nextPost, shelfBooks } = Astro.props;
const { year, month } = Astro.params;
const { Content } = await render(post);

const bskyInteractors: BskyActor[] = post.data.bskyPostUri ? await fetchBskyInteractors(post.data.bskyPostUri) : [];

const ogImage = post.data.image?.url ? new URL(`/og/${post.id}.png`, Astro.site).href : undefined;

const monthLabel = formatMonthYear(post.data.pubDate);
---

<Base title={post.data.title} description={post.data.description} ogImage={ogImage}>
	<article class='post-page' aria-labelledby='post-title'>
		<h1 id='post-title'>{post.data.title}</h1>
		{
			post.data.stale && (
				<p class='stale-warning'>
					<IconClock size={20} /> This post is now outdated, don't believe a word of it.
				</p>
			)
		}
		{
			post.data.image && imageFiles[`/src/assets/images/${post.data.image.url}`] && (
				<figure class='post-image'>
					<Image
						src={imageFiles[`/src/assets/images/${post.data.image.url}`]!.default}
						alt={post.data.image.alt}
					/>
					{post.data.image.source && (
						<figcaption>
							Image source:{' '}
							<a href={post.data.image.source}>
								{post.data.image.source.length > 80
									? post.data.image.source.slice(0, 80) + '…'
									: post.data.image.source}
							</a>
						</figcaption>
					)}
				</figure>
			)
		}
		<div class='post-body'>
			<div class='prose'>
				<Content />
			</div>
			<aside class='post-aside'>
				<div class='post-meta'>
					<div class='published-date'>
						Posted <time datetime={post.data.pubDate.toISOString()}
							>{formatDate(post.data.pubDate)}</time
						>
					</div>
					<TagPills tags={post.data.tags} />
				</div>
				<nav class='aside-links' aria-label='Post links'>
					<a href='/posts' class='back-link'>All posts</a>
					<a href={`/${year}/${month}`} class='month-link'>{monthLabel}</a>
					<a href='/tags' class='tags-link'>All tags</a>
					{shelfBooks.length > 0 && (
						<div class='shelf-section'>
							<p class='shelf-label'>On my shelf</p>
							{shelfBooks.map((book) => (
								<a href={`/shelf#book-${book.id}`} class='shelf-link'>{book.title}</a>
							))}
						</div>
					)}
					{
						post.data.bskyPostUri && (
							<div class='bsky-interactions'>
								<BskyInteractors
									uri={post.data.bskyPostUri}
									initial={bskyInteractors}
									client:visible
								/>
							</div>
						)
					}
				</nav>
			</aside>
		</div>
		{
			(prevPost || nextPost) && (
				<nav class='post-nav' aria-label='Post navigation'>
					<div class='post-nav-prev'>
						{prevPost && (
							<>
								<span class='post-nav-label'>Previous</span>
								<a href={prevPost.url} class='post-nav-title'>
									{prevPost.title}
								</a>
							</>
						)}
					</div>
					<div class='post-nav-next'>
						{nextPost && (
							<>
								<span class='post-nav-label'>Next</span>
								<a href={nextPost.url} class='post-nav-title'>
									{nextPost.title}
								</a>
							</>
						)}
					</div>
				</nav>
			)
		}
	</article>
</Base>

<style lang='scss'>
	@use 'sass:map';
	@use 'sass:color';
	@use '../../../styles/abstracts/breakpoints';
	@use '../../../styles/abstracts/layout';
	@use '../../../styles/abstracts/spacing';
	@use '../../../styles/abstracts/typography';
	@use '../../../styles/abstracts/colors';

	$sidebar-width: 220px;
	$body-gap: spacing.$space-12;

	article {
		flex: 1;
		margin: 0;
		padding: 0;

		h1 {
			@include typography.h1-content-page;

			@media (min-width: breakpoints.$md) {
				margin-bottom: spacing.$space-16;
			}
		}
	}

	.stale-warning {
		display: flex;
		align-items: center;
		gap: spacing.$space-2;
		color: colors.$text-muted;
		font-weight: typography.$weight-semibold;
		margin-bottom: spacing.$space-6;
	}

	.post-image {
		margin: spacing.$space-6 0 spacing.$space-16 0;
		max-width: layout.$prose-width;

		@media (min-width: breakpoints.$lg) {
			max-width: calc(#{layout.$prose-width} + #{$body-gap} + #{$sidebar-width});
		}

		img {
			display: block;
			width: 100%;
			height: auto;
			border-bottom: spacing.$space-2 solid colors.$primary;
		}

		figcaption {
			@include typography.caption-text;
			color: colors.$dark;
			margin-top: spacing.$space-2;

			:global(html[data-theme='dark']) & {
				color: colors.$light;
			}

			a {
				@include layout.body-link-full;
			}
		}
	}

	.post-body {
		margin-top: 0;

		@media (min-width: breakpoints.$lg) {
			display: grid;
			grid-template-columns: minmax(0, layout.$prose-width) $sidebar-width;
			gap: $body-gap;
			align-items: start;
			max-width: calc(#{layout.$prose-width} + #{$body-gap} + #{$sidebar-width});
		}
	}

	.prose {
		@include typography.prose;
	}

	.post-meta {
		margin-top: spacing.$space-6;

		@media (min-width: breakpoints.$lg) {
			margin-top: 0;
		}
	}

	.published-date {
		@include typography.meta-label;
		color: colors.$text-muted;
		margin-bottom: spacing.$space-2;

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');
		}
	}

	.bsky-interactions {
		margin-top: spacing.$space-6;
	}

	.bsky-interactions :global(.bsky-avatars--has-interactors) {
		padding-top: spacing.$space-6;
		border-top: spacing.$space-1 solid map.get(colors.$dark-tones, 'tone-5');
	}

	.aside-links {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: spacing.$space-3;
		margin-top: spacing.$space-6;
		padding-top: spacing.$space-6;
		border-top: spacing.$space-1 solid map.get(colors.$dark-tones, 'tone-5');
	}

	.back-link,
	.month-link,
	.tags-link {
		font-family: typography.$font-body;
		font-size: typography.$font-size-md;
		@include layout.body-link-full;
	}

	.shelf-section {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: spacing.$space-3;
		width: 100%;
		margin-top: spacing.$space-3;
		padding-top: spacing.$space-6;
		border-top: spacing.$space-1 solid map.get(colors.$dark-tones, 'tone-5');
	}

	.shelf-label {
		@include typography.meta-label;
		color: colors.$text-muted;
		margin: 0;

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');
		}
	}

	.shelf-link {
		font-family: typography.$font-body;
		font-size: typography.$font-size-md;
		@include layout.body-link-full;
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: spacing.$space-6;
		margin-top: spacing.$space-16;
		padding-top: spacing.$space-8;
		border-top: spacing.$space-1 solid map.get(colors.$dark-tones, 'tone-5');
		max-width: calc(#{layout.$prose-width} + #{$body-gap} + #{$sidebar-width});

		:global(html[data-theme='dark']) & {
			border-top-color: map.get(colors.$light-tones, 'tone-5');
		}
	}

	.post-nav-next {
		text-align: right;
	}

	.post-nav-label {
		@include typography.meta-label;
		color: colors.$text-muted;

		:global(html[data-theme='dark']) & {
			color: map.get(colors.$light-tones, 'tone-2');
		}
	}

	.post-nav-title {
		display: block;
		font-family: typography.$font-body;
		font-size: typography.$font-size-md;
		@include layout.body-link-full;
	}
</style>
