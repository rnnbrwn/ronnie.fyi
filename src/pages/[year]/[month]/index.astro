---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostListItem from '../../../components/PostListItem.astro';
import { formatMonthYear } from '../../../utils/getSortedPosts';

export async function getStaticPaths() {
	const now = new Date();
	const posts = (await getCollection('blog')).filter((p) => new Date(p.data.pubDate) <= now);

	const monthMap = new Map<string, { year: string; month: string; posts: CollectionEntry<'blog'>[] }>();
	for (const post of posts) {
		const year = String(post.data.pubDate.getFullYear());
		const month = String(post.data.pubDate.getMonth() + 1).padStart(2, '0');
		const key = `${year}/${month}`;
		if (!monthMap.has(key)) monthMap.set(key, { year, month, posts: [] });
		monthMap.get(key)!.posts.push(post);
	}

	return [...monthMap.values()].map(({ year, month, posts }) => ({
		params: { year, month },
		props: {
			year,
			month,
			posts: posts.sort(
				(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
			),
		},
	}));
}

const { year, month, posts } = Astro.props;

const monthLabel = formatMonthYear(new Date(Number(year), Number(month) - 1, 1));
---

<Base title={`Posts from ${monthLabel}`}>
	<h1>Posts from {monthLabel}</h1>
	<a href='/posts' class='archive-back-link'>All posts</a>
	<ul>
		{
			posts.map((post) => (
				<PostListItem
					id={post.id}
					title={post.data.title}
					pubDate={post.data.pubDate}
					description={post.data.description}
					stale={post.data.stale}
				/>
			))
		}
	</ul>
</Base>

<style lang='scss'>
	@use '../../../styles/abstracts/layout';

	ul {
		@include layout.list-reset;
	}
</style>
