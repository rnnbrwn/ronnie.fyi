---
import Base from '../layouts/Base.astro';
import IconBlueSky from '../components/IconBlueSky.astro';
import IconGitHub from '../components/IconGitHub.astro';
import IconInstagram from '../components/IconInstagram.astro';
import IconRSS from '../components/IconRSS.astro';
import { getPage } from '../utils/wordpress';

const pageTitle = 'About';
const page = await getPage('about');
---

<Base title={pageTitle} description='desc'>
	<h1>{pageTitle}</h1>
	<div class='wp-content'><Fragment set:html={page?.content} /></div>

	<p>Or, click these links.</p>

	<div class='social-links'>
		<a href='https://bsky.app/profile/ronnie.fyi' class='social-link' aria-label='Ronnie on Bluesky'>
			<IconBlueSky size={40} />
		</a>
		<a href='https://www.instagram.com/rnnbrwn/' class='social-link' aria-label='Ronnie on Instagram'>
			<IconInstagram size={40} />
		</a>
		<a href='https://github.com/rnnbrwn/' class='social-link' aria-label='Ronnie on GitHub'>
			<IconGitHub size={40} />
		</a>
		<a href='/rss' class='social-link' aria-label='RSS feed'>
			<IconRSS size={48} />
		</a>
	</div>
</Base>

<style lang='scss'>
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/typography';

	h1 {
		@include typography.h1-content-page;
	}

	p {
		max-width: layout.$prose-width;

		a {
			@include layout.body-link-full;
		}
	}

	.wp-content :global(p) {
		max-width: layout.$prose-width;

		:global(a) {
			@include layout.body-link-full;
		}
	}

	.social-link {
		color: colors.$dark;
		&:hover {
			color: colors.$tertiary;
		}
	}
</style>
