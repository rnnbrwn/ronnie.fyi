---
import Base from '../layouts/Base.astro';
import IconBlueSky from '../components/IconBlueSky.astro';
import IconGitHub from '../components/IconGitHub.astro';
import IconRSS from '../components/IconRSS.astro';

const pageTitle = 'About';
---

<Base title={pageTitle} description='desc'>
	<h1>{pageTitle}</h1>
	<p>
		Scottish dad. Technology managing, music listening, bass playing, Rangers FC supporting, Scottish Gàidhlig
		learning, self-proclaimed good egg. He/him.
	</p>

	<p>
		Here are <a href='/uses'>things I use</a> and a <a href='/changelog'>changelog</a>.
	</p>

	<p>Or, click these links.</p>

	<div class='social-links'>
		<a href='https://bsky.app/profile/ronnie.fyi' class='social-link' aria-label='Ronnie on Bluesky'>
			<IconBlueSky size={40} />
		</a>
		<a href='https://github.com/rnnbrwn/' class='social-link' aria-label='Ronnie on GitHub'>
			<IconGitHub size={40} />
		</a>
		<a href='/rss' class='social-link' aria-label='RSS feed'>
			<IconRSS size={48} />
		</a>
	</div>
</Base>

<style lang='scss'>
	@use '../styles/abstracts/colors';
	@use '../styles/abstracts/layout';

	p {
		max-width: layout.$prose-width;
	}

	.social-link {
		color: colors.$dark;
		&:hover {
			color: colors.$tertiary;
		}
	}
</style>
