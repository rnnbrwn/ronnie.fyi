---
import Base from '../layouts/Base.astro';

const buildDate = new Date().toISOString().replace('T', ' ').split('.')[0] + ' UTC';
---

<Base title='Changelog' description='A log of notable updates and changes to ronnie.fyi.'>
	<h1>Changelog</h1>
	<h2>April 2026</h2>
	<ul>
		<li>Bsky integration</li>
		<li>Post page layout changes</li>
		<li>Updated the colour scheme to provide more contrast and a more limited palette</li>
		<li>Dark mode, and toggle location</li>
		<li>Link colour fine-tuning throughout</li>
		<li>Add dates in Posts page</li>
	</ul>
	<h2>March 2026</h2>
	<ul>
		<li>Redesign</li>
	</ul>
	<hr />
	<pre>last build: {buildDate}</pre>
</Base>

<style lang='scss'>
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';

	ul {
		max-width: layout.$prose-width;
	}

	hr {
		margin: spacing.$space-12 0;
	}
</style>
