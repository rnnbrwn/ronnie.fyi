---
import Base from '../layouts/Base.astro';
import AllPosts from '../components/AllPosts.astro';
import Logo from '../components/Logo.astro';
import { getSortedPosts } from '../utils/getSortedPosts';

const PAGE_SIZE = 12;
const allPosts = await getSortedPosts();
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
---

<Base description='Writing about music, technology, and whatever else.'>
	<div class='site-header'>
		<h1 aria-label='ronnie.fyi'><Logo class='logo' aria-hidden='true' /></h1>
	</div>
	<AllPosts limit={12} pinFirst relativeDate />
	<nav class='pagination'>
		<span class='pagination-label'>Page 1 of {totalPages}</span>
		<a class='pagination-older' href='/posts/page/2'>Older posts</a>
	</nav>

	<style lang='scss'>
		@use '../styles/abstracts/colors';
		@use '../styles/abstracts/layout';
		@use '../styles/abstracts/spacing';
		@use '../styles/abstracts/typography';

		.site-header {
			margin-bottom: spacing.$space-16;
		}

		h1 {
			margin: 0;
		}

		:global(.post:last-of-type .post-body) {
			border-bottom: none;
		}

		.pagination {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			max-width: layout.$prose-width;
			margin-top: spacing.$space-8;
		}

		.pagination-label {
			@include typography.caption-text;
			color: colors.$text-muted;
			grid-column: 2;
			grid-row: 1;
			text-align: center;
		}

		.pagination-older {
			@include layout.body-link;
			grid-column: 1;
			grid-row: 1;
			justify-self: start;
		}

		.pagination-newer {
			grid-column: 3;
			grid-row: 1;
			justify-self: end;
		}

		h1 :global(.logo) {
			width: 250px;
			height: auto;
			color: colors.$primary;
			transform: rotate(-4deg);
			margin-bottom: spacing.$space-3;
		}
	</style>
</Base>
