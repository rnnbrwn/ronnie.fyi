---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagPills from '../../components/TagPills.astro';
import IconClock from '../../components/IconClock.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', { eager: true });

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
	<article aria-labelledby='post-title'>
		<h1 id='post-title'>{post.data.title}</h1>
		{
			post.data.stale && (
				<p class='stale-warning'>
					<IconClock size={20} /> This post is now outdated, don't believe a word of it.
				</p>
			)
		}
		{
			post.data.image && imageFiles[`/src/assets/images/${post.data.image.url}`] && (
				<figure class='post-image'>
					<Image
						src={imageFiles[`/src/assets/images/${post.data.image.url}`]!.default}
						alt={post.data.image.alt}
					/>
					{post.data.image.source && (
						<figcaption>
							Image source: <a href={post.data.image.source}>{post.data.image.source}</a>
						</figcaption>
					)}
				</figure>
			)
		}
		<div class='post-body'>
			<div class='prose'>
				<Content />
			</div>
			<aside class='post-aside'>
				<div class='post-meta'>
					<div class='published-date'>
						Posted <time datetime={post.data.pubDate.toISOString()}
							>{
								post.data.pubDate.toLocaleDateString('en-GB', {
									day: 'numeric',
									month: 'long',
									year: 'numeric',
								})
							}</time
						>
					</div>
					<TagPills tags={post.data.tags} />
				</div>
				<div class='aside-links'>
					<a href='/posts' class='back-link'>All posts</a>
					<a href='/tags' class='tags-link'>All tags</a>
				</div>
			</aside>
		</div>
	</article>
</Base>

<style lang='scss'>
	@use '../../styles/abstracts/spacing';
	@use '../../styles/abstracts/typography';
	@use '../../styles/abstracts/colors';

	$sidebar-width: 220px;
	$body-gap: spacing.$space-12;

	article {
		margin: 0;
		padding: 0;
	}

	.stale-warning {
		display: flex;
		align-items: center;
		gap: spacing.$space-2;
		color: colors.$secondary;
		font-weight: typography.$weight-semibold;
		margin-bottom: spacing.$space-6;
	}

	.post-image {
		margin: spacing.$space-6 0 0;
		max-width: 65ch;

		@media (min-width: 1400px) {
			max-width: calc(65ch + #{$body-gap} + #{$sidebar-width});
		}

		img {
			display: block;
			width: 100%;
			height: auto;
			border-bottom: spacing.$space-2 solid colors.$primary;
		}

		figcaption {
			@include typography.caption-text;
			color: colors.$dark;
			margin-top: spacing.$space-2;

			a {
				color: inherit;
			}
		}
	}

	.post-body {
		margin-top: spacing.$space-16;

		@media (min-width: 1400px) {
			display: grid;
			grid-template-columns: minmax(0, 65ch) $sidebar-width;
			gap: $body-gap;
			align-items: start;
			max-width: calc(65ch + #{$body-gap} + #{$sidebar-width});
		}
	}

	.prose {
		@include typography.prose;
	}

	.post-meta {
		margin-top: spacing.$space-6;

		@media (min-width: 1400px) {
			margin-top: 0;
		}
	}

	.published-date {
		@include typography.caption-text;
		font-weight: typography.$weight-bold;
		color: colors.$dark;
		margin-bottom: spacing.$space-2;
	}

	.aside-links {
		display: flex;
		flex-wrap: wrap;
		gap: spacing.$space-2;
		margin-top: spacing.$space-6;
	}

	.back-link {
		display: inline-block;
		font-family: typography.$font-body;
		font-size: typography.$font-size-md;
		font-weight: typography.$weight-bold;
		letter-spacing: typography.$tracking-wider;
		text-transform: uppercase;
		text-decoration: none;
		color: colors.$light;
		background-color: colors.$tertiary;
		border: 2px solid transparent;
		line-height: 1;
		padding: spacing.$space-2 spacing.$space-4;
		border-radius: 3px;
		&:hover {
			background-color: colors.$tertiary;
			color: colors.$light;
		}
	}

	.tags-link {
		display: inline-block;
		font-family: typography.$font-body;
		font-size: typography.$font-size-md;
		font-weight: typography.$weight-bold;
		letter-spacing: typography.$tracking-wider;
		text-transform: uppercase;
		text-decoration: none;
		color: colors.$tertiary;
		background-color: transparent;
		border: 2px solid colors.$tertiary;
		line-height: 1;
		padding: spacing.$space-2 spacing.$space-4;
		border-radius: 3px;

		&:visited {
			color: colors.$tertiary;
		}

		&:hover {
			color: colors.$tertiary;
			border-color: colors.$tertiary;
		}
	}
</style>
