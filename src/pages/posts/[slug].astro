---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagPills from '../../components/TagPills.astro';
import { timeAgo } from '../../utils/timeAgo';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
	<article aria-labelledby='post-title'>
		<h1 id='post-title'>{post.data.title}</h1>
		<div class='prose'>
		{post.data.image && (
			<figure class='post-image'>
				<img src={post.data.image.url} alt={post.data.image.alt} />
				{post.data.image.source && (
					<figcaption>Image source: <a href={post.data.image.source}>{post.data.image.source}</a></figcaption>
				)}
			</figure>
		)}
			<Content />
			<div class='post-meta'>
				<div class='published-date'>Posted around <time datetime={post.data.pubDate.toISOString()}>{timeAgo(post.data.pubDate)}</time></div>
				<TagPills tags={post.data.tags} />
			</div>
			<a href='/blog' class='back-link'>← All posts</a>
		</div>
	</article>
</Base>

<style lang='scss'>
	@use 'sass:map';
	@use '../../styles/abstracts/spacing';
	@use '../../styles/abstracts/typography';
	@use '../../styles/abstracts/colors';

	article {
		margin: 0;
		padding: 0;
	}

	.post-image {
		margin: 0 0 spacing.$space-6;

		img {
			display: block;
			width: 100%;
			height: auto;
		}

		figcaption {
			@include typography.caption-text;
			color: map.get(colors.$graphite-tones, 'tone-2');
			margin-top: spacing.$space-2;

			a {
				color: inherit;
			}
		}
	}

	.prose {
		@include typography.prose;
		margin-top: spacing.$space-6;

		// Vertical rhythm
		:global(p),
		:global(ul),
		:global(ol),
		:global(blockquote),
		:global(pre),
		:global(.youtube-embed) {
			margin-bottom: spacing.$space-6;
			color: colors.$graphite;
		}

		:global(h2) {
			font-size: typography.$font-size-2xl;
		}

		:global(ul),
		:global(ol) {
			padding-left: spacing.$space-6;
		}

		:global(li) {
			margin-bottom: spacing.$space-2;
		}

		:global(blockquote) {
			padding-left: spacing.$space-6;
			border-left: 3px solid colors.$graphite;
			font-style: italic;
		}

		:global(code) {
			font-family: typography.$font-mono;
			font-size: typography.$font-size-md;
		}

		:global(a:not(.tag-pill)) {
			color: colors.$petrol;

			&:hover {
				color: colors.$petrol;
			}
		}

		:global(pre) {
			padding: spacing.$space-4;
			overflow-x: auto;
			font-size: typography.$font-size-md;
			line-height: typography.$leading-normal;
			border-radius: spacing.$space-2;
		}

		.post-meta {
			margin-top: spacing.$space-6;
		}

		.published-date {
			@include typography.caption-text;
			font-weight: typography.$weight-bold;
			color: colors.$graphite;
			margin-bottom: spacing.$space-2;
		}

		.back-link {
			@include typography.caption-text;
			display: inline-block;
			font-weight: typography.$weight-bold;
			color: colors.$petrol;
			text-decoration: none;
			margin-top: spacing.$space-4;
			padding-block: spacing.$space-2;

			&:hover {
				text-decoration: underline;
			}
		}
	}
</style>
