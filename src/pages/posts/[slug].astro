---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagPills from '../../components/TagPills.astro';
import IconClock from '../../components/IconClock.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*', { eager: true });

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
	<article aria-labelledby='post-title'>
		<h1 id='post-title'>{post.data.title}</h1>
		{
			post.data.stale && (
				<p class='stale-warning'>
					<IconClock size={20} /> This post is now outdated, don't believe a word of it.
				</p>
			)
		}
		<div class='prose'>
			{
				post.data.image && imageFiles[`/src/assets/images/${post.data.image.url}`] && (
					<figure class='post-image'>
						<Image src={imageFiles[`/src/assets/images/${post.data.image.url}`]!.default} alt={post.data.image.alt} />
						{post.data.image.source && (
							<figcaption>
								Image source: <a href={post.data.image.source}>{post.data.image.source}</a>
							</figcaption>
						)}
					</figure>
				)
			}
			<Content />
			<div class='post-meta'>
				<div class='published-date'>
					Posted <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
				</div>
				<TagPills tags={post.data.tags} />
			</div>
			<a href='/posts' class='back-link'>← All posts</a>
		</div>
	</article>
</Base>

<style lang='scss'>
	@use '../../styles/abstracts/spacing';
	@use '../../styles/abstracts/typography';
	@use '../../styles/abstracts/colors';

	article {
		margin: 0;
		padding: 0;
	}

	.stale-warning {
		display: flex;
		align-items: center;
		gap: spacing.$space-2;
		color: colors.$red;
		font-weight: typography.$weight-semibold;
		margin-bottom: spacing.$space-6;
	}

	.prose {
		@include typography.prose;
		margin-top: spacing.$space-6;

		.post-meta {
			margin-top: spacing.$space-6;
		}

		.published-date {
			@include typography.caption-text;
			font-weight: typography.$weight-bold;
			color: colors.$graphite;
			margin-bottom: spacing.$space-2;
		}

		.back-link {
			@include typography.caption-text;
			display: inline-block;
			font-weight: typography.$weight-bold;
			color: colors.$petrol;
			text-decoration: none;
			margin-top: spacing.$space-4;
			padding-block: spacing.$space-2;

			&:hover {
				text-decoration: underline;
			}
		}
	}
</style>
