---
import Base from '../../layouts/Base.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getSortedPosts, formatMonthYear, isDraft } from '../../utils/getSortedPosts';
import type { AnyPost } from '../../utils/getSortedPosts';

const allPosts = await getSortedPosts();
const posts = allPosts.filter((p) => p.collection === 'blog' || p.collection === 'shelf-events');

const grouped: Record<string, AnyPost[]> = {};
for (const post of posts) {
	const key = formatMonthYear(post.entry.data.pubDate);
	(grouped[key] ??= []).push(post);
}
const groupedPosts = Object.entries(grouped);
---

<Base title='Blog'>
	<h1>All Posts</h1>
	{
		groupedPosts.map(([month, monthPosts]) => (
			<section>
				<h2>{month}</h2>
				<ul>
					{monthPosts.map((post) => {
						const isShelfEvent = post.collection === 'shelf-events';
						return (
							<PostListItem
								id={post.entry.id}
								title={post.entry.data.title}
								pubDate={post.entry.data.pubDate}
								description={'description' in post.entry.data ? post.entry.data.description : undefined}
								stale={post.collection === 'blog' ? post.entry.data.stale : false}
								draft={isDraft(post.entry.id)}
								isShelfEvent={isShelfEvent}
								href={isShelfEvent ? '/shelf' : undefined}
							/>
						);
					})}
				</ul>
			</section>
		))
	}
</Base>

<style lang='scss'>
	@use '../../styles/abstracts/colors';
	@use '../../styles/abstracts/layout';
	@use '../../styles/abstracts/spacing';
	@use '../../styles/abstracts/typography';

	h1 {
		@include typography.h1-content-page;
	}

	h2 {
		font-family: typography.$font-body;
		font-size: typography.$font-size-lg;
		line-height: typography.$leading-normal;
		letter-spacing: typography.$tracking-wide;
		font-weight: typography.$weight-bold;
		text-transform: uppercase;
		color: colors.$dark;
		margin-top: spacing.$space-10;
		margin-bottom: spacing.$space-4;
	}

	ul {
		@include layout.list-reset;
	}
</style>
