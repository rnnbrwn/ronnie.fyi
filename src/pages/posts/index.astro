---
import Base from '../../layouts/Base.astro';
import IconClock from '../../components/IconClock.astro';
import { getSortedPosts, getPostUrl } from '../../utils/getSortedPosts';

const allPosts = await getSortedPosts();
const posts = allPosts.filter((p) => p.collection === 'blog').map((p) => p.entry);
---

<Base title='Blog'>
	<h1>All Posts</h1>
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={getPostUrl(post.data.pubDate, post.id)}>
						{post.data.title}
						{post.data.stale && <IconClock class='stale-icon' size={20} />}
					</a>
					<time datetime={post.data.pubDate.toISOString()}>
						{post.data.pubDate.toLocaleDateString('en-GB', {
							day: 'numeric',
							month: 'short',
							year: 'numeric',
						})}
					</time>
					<p>{post.data.description}</p>
				</li>
			))
		}
	</ul>
</Base>

<style lang='scss'>
	@use '../../styles/abstracts/colors';
	@use '../../styles/abstracts/spacing';
	@use '../../styles/abstracts/typography';
	@use 'sass:map';

	ul {
		padding: 0;
		list-style: none;
	}

	li {
		margin-block-end: spacing.$space-8;
	}

	time {
		@include typography.caption-text;
		display: block;
		font-weight: typography.$weight-bold;
		color: colors.$dark;
		margin-bottom: spacing.$space-1;
	}

	:global([data-theme='dark']) time {
		color: colors.$light;
	}

	:global(.stale-icon) {
		display: inline-block !important;
		vertical-align: middle;
		color: map.get(colors.$dark-tones, 'tone-2');
		margin-left: spacing.$space-2;
		transform: translateY(-5px);
	}

	a {
		display: block;
		font-size: typography.$font-size-xl;
		font-weight: typography.$weight-bold;
		color: colors.$dark;
		text-decoration: none;
		margin-bottom: spacing.$space-1;

		&:visited {
			color: colors.$dark;
		}

		&:hover {
			color: colors.$tertiary;
		}
	}

	:global([data-theme='dark']) a {
		color: colors.$light;

		&:visited {
			color: colors.$light;
		}
	}

	p {
		font-size: typography.$font-size-lg;
		color: map.get(colors.$dark-tones, 'tone-2');
		margin: 0;
		line-height: typography.$leading-normal;
		max-width: 65ch;
	}
</style>
