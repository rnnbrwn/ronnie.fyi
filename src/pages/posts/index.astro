---
import Base from '../../layouts/Base.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getSortedPosts, formatMonthYear } from '../../utils/getSortedPosts';

const allPosts = await getSortedPosts();
const posts = allPosts.filter((p) => p.collection === 'blog').map((p) => p.entry);

const grouped: Record<string, typeof posts> = {};
for (const post of posts) {
	const key = formatMonthYear(post.data.pubDate);
	(grouped[key] ??= []).push(post);
}
const groupedPosts = Object.entries(grouped);
---

<Base title='Blog'>
	<h1>All Posts</h1>
	{
		groupedPosts.map(([month, monthPosts]) => (
			<>
				<h2>{month}</h2>
				<ul>
					{monthPosts.map((post) => (
						<PostListItem
							id={post.id}
							title={post.data.title}
							pubDate={post.data.pubDate}
							description={post.data.description}
							stale={post.data.stale}
						/>
					))}
				</ul>
			</>
		))
	}
</Base>

<style lang='scss'>
	@use '../../styles/abstracts/layout';
	@use '../../styles/abstracts/spacing';

	ul {
		@include layout.list-reset;
	}
</style>
