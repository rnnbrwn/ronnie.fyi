---
import Base from '../../layouts/Base.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getSortedPosts, formatMonthYear, isDraft } from '../../utils/getSortedPosts';

const allPosts = await getSortedPosts();
const posts = allPosts.filter((p) => p.collection === 'blog').map((p) => p.entry);

const grouped: Record<string, typeof posts> = {};
for (const post of posts) {
	const key = formatMonthYear(post.data.pubDate);
	(grouped[key] ??= []).push(post);
}
const groupedPosts = Object.entries(grouped);
---

<Base title='Blog'>
	<h1>All Posts</h1>
	{
		groupedPosts.map(([month, monthPosts]) => (
			<>
				<h2>{month}</h2>
				<ul>
					{monthPosts.map((post) => (
						<PostListItem
							id={post.id}
							title={post.data.title}
							pubDate={post.data.pubDate}
							description={post.data.description}
							stale={post.data.stale}
							draft={isDraft(post.id)}
						/>
					))}
				</ul>
			</>
		))
	}
</Base>

<style lang='scss'>
	@use '../../styles/abstracts/colors';
	@use '../../styles/abstracts/layout';
	@use '../../styles/abstracts/spacing';
	@use '../../styles/abstracts/typography';

	h1 {
		@include typography.h1-page-title;
		@include layout.h1-saffron-underlay;
	}

	h2 {
		font-family: typography.$font-body;
		font-size: typography.$font-size-lg;
		line-height: typography.$leading-normal;
		letter-spacing: typography.$tracking-wide;
		font-weight: typography.$weight-bold;
		text-transform: uppercase;
		color: colors.$dark;
		margin-top: spacing.$space-10;
		margin-bottom: spacing.$space-4;
	}

	ul {
		@include layout.list-reset;
	}
</style>
