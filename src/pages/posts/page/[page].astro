---
import Base from '../../../layouts/Base.astro';
import AllPosts from '../../../components/AllPosts.astro';
import { getSortedPosts } from '../../../utils/getSortedPosts';

export async function getStaticPaths() {
	const PAGE_SIZE = 12;
	const allPosts = await getSortedPosts();
	const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

	return Array.from({ length: totalPages - 1 }, (_, i) => ({
		params: { page: String(i + 2) },
		props: { page: i + 2, totalPages, pageSize: PAGE_SIZE },
	}));
}

const { page, totalPages, pageSize } = Astro.props;
const offset = (page - 1) * pageSize;
const isFirst = page === 2;
const isLast = page === totalPages;
---

<Base title={`Posts – Page ${page}`}>
	<AllPosts limit={pageSize} offset={offset} />
	<nav class='pagination' aria-label='Pagination'>
		{!isLast && <a class='pagination-older' href={`/posts/page/${page + 1}`}>Older posts</a>}
		<span class='pagination-label'>Page {page} of {totalPages}</span>
		<a class='pagination-newer' href={isFirst ? '/' : `/posts/page/${page - 1}`}>Newer posts</a>
	</nav>
</Base>

<style lang='scss'>
	@use '../../../styles/abstracts/colors';
	@use '../../../styles/abstracts/layout';
	@use '../../../styles/abstracts/spacing';
	@use '../../../styles/abstracts/typography';

	:global(.post:last-of-type .post-body) {
		border-bottom: none;
	}

	.pagination {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: layout.$prose-width;
		margin-top: spacing.$space-8;
	}

	.pagination-label {
		@include typography.caption-text;
		color: colors.$text-muted;
		grid-column: 2;
		grid-row: 1;
		text-align: center;
	}

	.pagination-older {
		grid-column: 1;
		grid-row: 1;
		justify-self: start;
	}

	.pagination-newer {
		grid-column: 3;
		grid-row: 1;
		justify-self: end;
	}
</style>
