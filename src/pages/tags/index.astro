---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog');
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Base title='Tags'>
	<h1>Tags</h1>
	<ul>
		{
			tags.map((tag) => (
				<li>
					<a href={`/tags/${tag}`}>#{tag}</a>
				</li>
			))
		}
	</ul>
</Base>

<style lang='scss'>
	@use '../../styles/abstracts/layout';
	@use '../../styles/abstracts/spacing';
	@use '../../styles/abstracts/typography';

	h1 {
		@include typography.h1-page-title;
		@include layout.h1-saffron-underlay;
	}

	ul {
		@include layout.list-reset;
		display: flex;
		flex-wrap: wrap;
		gap: spacing.$space-3;
		max-width: layout.$prose-width;
	}

	a {
		font-size: typography.$font-size-lg;
		@include layout.body-link;

		:global(html[data-theme='dark']) & {
			@include layout.body-link-on-dark;
		}
	}
</style>
