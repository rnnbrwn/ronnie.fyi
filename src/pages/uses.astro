---
import Base from '../layouts/Base.astro';
import { getPage } from '../utils/wordpress';

const page = await getPage('uses');
---

<Base title='Uses' description='Things Ronnie uses.'>
	<h1>Uses</h1>
	<div class='wp-content'><Fragment set:html={page?.content} /></div>
</Base>

<style lang='scss'>
	@use '../styles/abstracts/layout';
	@use '../styles/abstracts/spacing';
	@use '../styles/abstracts/typography';

	h1 {
		@include typography.h1-content-page;
	}

	.wp-content :global(h2) {
		@include typography.h2-section-label;
	}

	.wp-content :global(a) {
		@include layout.body-link-full;
	}

	.wp-content :global(section) {
		margin-bottom: spacing.$space-8;
	}
</style>
